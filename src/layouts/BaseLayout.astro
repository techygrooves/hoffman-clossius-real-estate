---
/**
 * BaseLayout — the single HTML shell for every page.
 *
 * Owns <head>, the skip link, the global header/footer and the one global
 * client script. Pages supply content and metadata only.
 */
import { site } from '@config/site';
import SeoHead from '@components/seo/SeoHead.astro';
import { buildPageMeta, type RobotsPolicy } from '@lib/seo/meta';
import {
  organisationSchema,
  webPageSchema,
  websiteSchema,
  type JsonLd,
} from '@lib/seo/schema';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import MobileActionBar from '@components/layout/MobileActionBar.astro';
import '@styles/global.css';

interface Props {
  /** Page title without the site suffix. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Overrides the automatic "Title | Hoffman & Closius" pattern. */
  fullTitle?: string;
  /** Social share image under /public. */
  ogImage?: string;
  /** Keeps a page out of search results (login, register, thank-you pages). */
  noindex?: boolean;
  /** Extra classes on <main>. */
  mainClass?: string;
  /**
   * Suppresses the global mobile action bar. Set by pages that pin their own
   * bottom bar — two stacked bars would collide on a phone.
   */
  hideMobileActionBar?: boolean;
  bodyClass?: string;
  /** 'article' for journal posts. Everything else is a website page. */
  ogType?: 'website' | 'article';
  /** ISO dates, articles only. */
  publishedTime?: string | null;
  modifiedTime?: string | null;
  /** Extra JSON-LD nodes from `@lib/seo/schema`. Nulls are dropped. */
  schema?: (JsonLd | null | undefined)[];
}

const {
  title,
  description = site.description,
  fullTitle,
  ogImage,
  noindex = false,
  mainClass,
  bodyClass,
  hideMobileActionBar = false,
  ogType = 'website',
  publishedTime = null,
  modifiedTime = null,
  schema: extraSchema = [],
} = Astro.props;

const robots: RobotsPolicy = noindex ? 'noindex' : 'index';

const meta = buildPageMeta({
  title,
  fullTitle,
  description,
  pathname: Astro.url.pathname,
  ogImage,
  robots,
  ogType,
  publishedTime,
  modifiedTime,
});

/*
 * The site-wide graph, on every page: the organisation and the website, plus
 * this page and its breadcrumb trail. Each generator returns null when the
 * facts it needs are missing, so nothing here can publish a claim the site
 * does not hold — see the header of @lib/seo/schema.
 */
const schema = [
  organisationSchema(),
  websiteSchema(),
  webPageSchema({ title: meta.title, description: meta.description, canonical: meta.canonical }),
  // The BreadcrumbList is emitted by Breadcrumbs.astro, which holds the trail
  // that is actually rendered. Emitting it here too would describe the same
  // page with two competing trails.
  ...extraSchema,
];
---

<!doctype html>
<html lang={site.lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <SeoHead meta={meta} schema={schema} />

    {/* Fonts: self-hosted, latin subset. Only the two faces that render above
        the fold are preloaded — preloading everything competes with the
        markup for the first connections and delays first paint. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin-wght-normal.woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/cormorant-garamond-latin-wght-normal.woff2"
      crossorigin="anonymous"
    />

    {/* apple-touch-icon.png + favicon.ico still to be produced — CONTENT_PENDING.md 1.5 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a
      href="#main"
      data-surface="dark"
      class="skip-link rounded-xs bg-evergreen-800 px-5 py-3 text-sm text-white shadow-elevated"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <Footer />

    {!hideMobileActionBar && <MobileActionBar />}

    <script>
      import { initReveal } from '@lib/reveal';
      initReveal();
    </script>
  </body>
</html>
