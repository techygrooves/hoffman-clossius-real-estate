---
/**
 * InPreparation — honest build-stage notice for a route that exists but has
 * not been populated yet.
 *
 * This is scaffolding, not production copy. Every page still carrying it is
 * listed in BUILD_PROGRESS.md, and it must be removed as each page is built.
 * It deliberately makes no claim about the business and contains no filler
 * text posing as real content.
 */
import { professionals } from '@config/site';
import Section from '@components/ui/Section.astro';
import Button from '@components/ui/Button.astro';

interface Props {
  /** What this page will contain, in plain language. */
  note?: string;
}

const {
  note = 'This page is being built. The content below will follow.',
} = Astro.props;
---

<Section tone="warm" data-page-status="in-preparation">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="flex max-w-2xl flex-col gap-4" data-reveal>
      <p class="eyebrow text-evergreen-600">
        <span class="rule-gold" aria-hidden="true"></span>
        In preparation
      </p>
      <h2 class="text-display-sm text-evergreen-800">
        Content for this page is on the way.
      </h2>
      <p class="text-lg leading-relaxed text-ink-muted">{note}</p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0" data-reveal>
      <Button href="/contact/" withArrow>Get in touch</Button>
    </div>
  </div>

  <div class="mt-14 grid gap-6 border-t border-line pt-10 sm:grid-cols-2">
    {
      professionals.map((person) => (
        <div class="flex flex-col gap-1.5" data-reveal>
          <p class="font-serif text-2xl text-evergreen-800">{person.name}</p>
          <p class="eyebrow text-ink-subtle">
            {person.specialty
              ? `${person.title} · ${person.specialty}`
              : person.title}
          </p>
          <div class="mt-2 flex flex-col gap-1 text-sm text-ink-muted">
            <a href={person.phone.href} class="link-underline w-fit hover:text-evergreen-800">
              {person.phone.value}
            </a>
            <a href={person.email.href} class="link-underline w-fit break-all hover:text-evergreen-800">
              {person.email.value}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</Section>
