---
/**
 * TestimonialCard — one client quote.
 *
 * Renders only what was supplied. Location, source and date are each nullable
 * and each simply absent when null — no "Location not provided", no dash, no
 * placeholder. A card with just a quote and a name is a complete card.
 *
 * Nothing here is editorialised: the quote is rendered as given, and there is
 * no rating, no star row and no review count anywhere in the component.
 */
import type { Testimonial } from '@data/testimonials';
import TestimonialSourceBadge from './TestimonialSourceBadge.astro';
import { formatDate } from '@lib/format';
import { cn } from '@lib/cn';

interface Props {
  testimonial: Testimonial;
  /** `feature` gives the first quote on a page more room. */
  variant?: 'default' | 'feature';
  class?: string;
}

const { testimonial, variant = 'default', class: className } = Astro.props;
const isFeature = variant === 'feature';
---

<figure
  class={cn(
    'flex h-full flex-col rounded-xs border border-line bg-white',
    isFeature ? 'p-8 sm:p-12' : 'p-8',
    className,
  )}
>
  <svg
    class={cn('shrink-0 text-gold-500', isFeature ? 'h-8 w-8' : 'h-6 w-6')}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M9.6 5.4A6.6 6.6 0 0 0 3 12v6.6h6.6V12H6.3a3.3 3.3 0 0 1 3.3-3.3V5.4Zm11.4 0A6.6 6.6 0 0 0 14.4 12v6.6H21V12h-3.3A3.3 3.3 0 0 1 21 8.7V5.4Z"
    ></path>
  </svg>

  <blockquote class={cn('flex-1', isFeature ? 'mt-8' : 'mt-6')}>
    <p
      class={cn(
        'font-serif leading-relaxed text-evergreen-800',
        isFeature ? 'text-2xl sm:text-3xl' : 'text-xl',
      )}
    >
      {testimonial.quote}
    </p>
  </blockquote>

  <figcaption class={cn('border-t border-line', isFeature ? 'mt-8 pt-6' : 'mt-6 pt-5')}>
    <p class="text-sm font-medium text-evergreen-800">{testimonial.clientName}</p>

    {
      testimonial.location && (
        <p class="mt-0.5 text-xs text-ink-muted">{testimonial.location}</p>
      )
    }

    {
      (testimonial.source || testimonial.date) && (
        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
          {testimonial.source && (
            <TestimonialSourceBadge
              source={testimonial.source}
              href={testimonial.sourceUrl}
            />
          )}
          {testimonial.date && (
            <time datetime={testimonial.date} class="text-xs text-ink-subtle">
              {formatDate(testimonial.date)}
            </time>
          )}
        </div>
      )
    }
  </figcaption>
</figure>
