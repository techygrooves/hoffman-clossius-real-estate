---
/**
 * PersonContactCard — direct line, email and the ways to start something.
 *
 * Both numbers are the professionals' own direct lines. There is no confirmed
 * shared office number, office address or set of opening hours, so none is
 * shown and none is implied (CONTENT_PENDING.md 2.1–2.3).
 */
import Button from '@components/ui/Button.astro';
import type { Professional } from '@config/site';
import { cn } from '@lib/cn';

interface Props {
  person: Professional;
  /** Shown above the contact details. */
  heading?: string;
  class?: string;
}

const { person, heading = 'Contact', class: className } = Astro.props;
---

<div class={cn('rounded-xs border border-line bg-cream-50 p-6 sm:p-8', className)}>
  <span class="rule-gold" aria-hidden="true"></span>
  <h2 class="mt-4 font-serif text-2xl text-evergreen-800">{heading}</h2>

  <p class="mt-3 text-sm leading-relaxed text-ink-muted">
    {person.firstName} answers {person.firstName === 'Martin' ? 'his' : 'her'} own
    phone. There is no call centre and no assistant in between.
  </p>

  <dl class="mt-6 flex flex-col gap-5 border-t border-line pt-6">
    <div>
      <dt class="text-xs uppercase tracking-wide-sm text-ink-subtle">Direct line</dt>
      <dd class="mt-1">
        <a href={person.phone.href} class="link-underline text-lg text-evergreen-800">
          <span class="sr-only">Call {person.name} on </span>
          {person.phone.value}
        </a>
      </dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide-sm text-ink-subtle">Email</dt>
      <dd class="mt-1 break-all">
        <a href={person.email.href} class="link-underline text-sm text-evergreen-800">
          <span class="sr-only">Email {person.name} at </span>
          {person.email.value}
        </a>
      </dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide-sm text-ink-subtle">Working across</dt>
      <dd class="mt-1 text-sm text-ink-muted">
        Broward, Palm Beach and Miami-Dade counties
      </dd>
    </div>
  </dl>

  <div class="mt-7 flex flex-col gap-3">
    <Button href={person.phone.href} block>Call {person.firstName}</Button>
    <Button href="/contact/" variant="secondary" block>Send a message</Button>
  </div>
</div>
