---
/**
 * ListingCard — one property. Reused by the homepage grid and, later, by the
 * search results and listing index pages.
 *
 * Renders only fields that are present: a listing with no square footage shows
 * no square-footage row rather than a dash or a guess.
 */
import type { Listing } from '@data/listings';
import { formatPrice, formatNumber } from '@lib/format';
import { cn } from '@lib/cn';
import MediaSlot from './MediaSlot.astro';

interface Props {
  listing: Listing;
  /** Flags the card as placeholder content, visibly. */
  isDemo?: boolean;
  seed?: number;
  /** Sets the heading level so the card fits the page's outline. */
  headingLevel?: 'h3' | 'h4';
  class?: string;
}

const {
  listing,
  isDemo = false,
  seed = 0,
  headingLevel: Heading = 'h3',
  class: className,
} = Astro.props;

const price = formatPrice(listing.price);
const isRental = listing.status === 'for-rent' || listing.status === 'leased';

const STATUS_LABELS: Record<Listing['status'], string> = {
  'for-sale': 'For Sale',
  'for-rent': 'For Rent',
  pending: 'Pending',
  sold: 'Sold',
  leased: 'Leased',
};

/** Only the facts we actually hold. */
const specs = [
  listing.beds !== null && { label: listing.beds === 1 ? 'Bed' : 'Beds', value: String(listing.beds) },
  listing.baths !== null && {
    label: listing.baths === 1 && !listing.halfBaths ? 'Bath' : 'Baths',
    value: listing.halfBaths ? `${listing.baths}.${listing.halfBaths}` : String(listing.baths),
  },
  listing.livingAreaSqFt !== null && { label: 'Sq Ft', value: formatNumber(listing.livingAreaSqFt) },
].filter((s): s is { label: string; value: string } => Boolean(s));

const href = `/property/${listing.slug}/`;
---

<article
  class={cn(
    'group relative flex flex-col overflow-hidden rounded-xs border border-line bg-white',
    'transition-shadow duration-500 ease-[var(--ease-editorial)] hover:shadow-card',
    className,
  )}
  data-reveal
>
  <div class="relative overflow-hidden">
    <MediaSlot
      src={listing.images[0]?.src ?? null}
      alt={listing.images[0]?.alt ?? ''}
      width={800}
      height={600}
      ratio="4/3"
      seed={seed}
      marker={false}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      imgClass="transition-transform duration-700 ease-[var(--ease-editorial)] motion-safe:group-hover:scale-[1.04]"
    />

    {/* Badges */}
    <div class="pointer-events-none absolute left-4 top-4 flex flex-wrap gap-2">
      <span class="rounded-xs bg-evergreen-800/95 px-2.5 py-1 text-[0.625rem] uppercase tracking-eyebrow text-white backdrop-blur-sm">
        {STATUS_LABELS[listing.status]}
      </span>
      {
        listing.isOurListing && (
          <span class="rounded-xs bg-gold-500 px-2.5 py-1 text-[0.625rem] uppercase tracking-eyebrow text-evergreen-900">
            Our Listing
          </span>
        )
      }
    </div>

    {
      isDemo && (
        <span class="pointer-events-none absolute right-4 top-4 rounded-xs border border-dashed border-white/60 bg-charcoal-900/70 px-2.5 py-1 text-[0.625rem] uppercase tracking-eyebrow text-white backdrop-blur-sm">
          Sample
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    {
      price && (
        <p class="font-serif text-2xl text-evergreen-800">
          {price}
          {isRental && <span class="text-base text-ink-muted"> / month</span>}
        </p>
      )
    }

    <Heading class="mt-2 font-sans text-sm font-medium leading-snug text-ink">
      <a href={href} class="after:absolute after:inset-0 after:content-['']">
        {listing.addressLine}
      </a>
    </Heading>

    <p class="mt-1 text-sm text-ink-muted">
      {listing.city}, {listing.state} {listing.postalCode}
    </p>

    {
      specs.length > 0 && (
        <dl class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-4 text-sm">
          {specs.map((spec) => (
            <div class="flex items-baseline gap-1.5">
              <dd class="font-medium text-evergreen-800">{spec.value}</dd>
              <dt class="text-xs uppercase tracking-wide-sm text-ink-subtle">
                {spec.label}
              </dt>
            </div>
          ))}
        </dl>
      )
    }

    <p class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-eyebrow text-evergreen-700">
      View Property
      <svg
        class="h-3 w-3 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M1 8h13M9 3l5 5-5 5"></path>
      </svg>
    </p>
  </div>
</article>
