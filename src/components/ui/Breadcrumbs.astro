---
/**
 * Breadcrumbs — accessible trail with matching BreadcrumbList structured data.
 * `items` should NOT include the home link; it is prepended automatically.
 */
import { cn } from '@lib/cn';
import { breadcrumbSchema, graph } from '@lib/seo/schema';

export type Crumb = { label: string; href?: string };

interface Props {
  items: Crumb[];
  tone?: 'dark' | 'light';
  class?: string;
}

const { items, tone = 'dark', class: className } = Astro.props;

const trail: Crumb[] = [{ label: 'Home', href: '/' }, ...items];

/*
 * One implementation of the trail, shared with every other generator, in
 * @lib/seo/schema. This component owns the BreadcrumbList for the whole site
 * because it holds the trail that is actually rendered — BaseLayout
 * deliberately does not emit one.
 */
/* graph() adds the @context this needs as a standalone block — the generators
   themselves return bare nodes so they can be composed into BaseLayout's
   @graph without repeating it. */
const jsonLd = graph(breadcrumbSchema(trail));

const isLight = tone === 'light';
---

<nav
  aria-label="Breadcrumb"
  class={cn('text-xs tracking-wide-sm', className)}
>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      trail.map((crumb, index) => {
        const isLast = index === trail.length - 1;
        return (
          <li class="flex items-center gap-2">
            {index > 0 && (
              <span
                aria-hidden="true"
                class={isLight ? 'text-white/40' : 'text-ink-subtle'}
              >
                /
              </span>
            )}
            {crumb.href && !isLast ? (
              <a
                href={crumb.href}
                class={cn(
                  'link-underline transition-colors',
                  isLight
                    ? 'text-white/70 hover:text-white'
                    : 'text-ink-muted hover:text-evergreen-800',
                )}
              >
                {crumb.label}
              </a>
            ) : (
              <span
                aria-current={isLast ? 'page' : undefined}
                class={isLight ? 'text-white' : 'text-evergreen-800'}
              >
                {crumb.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={jsonLd} />
