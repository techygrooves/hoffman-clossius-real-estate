---
/**
 * AgentCard — one professional, with a portrait slot.
 *
 * The intro line is deliberately role-descriptive only. Nothing here asserts
 * experience, volume, awards or specialisms beyond the titles the client has
 * confirmed. Full biographies are pending (CONTENT_PENDING.md 8.1–8.2) and go
 * into `professionals[].bio`; portraits into `professionals[].portrait`.
 */
import type { Professional } from '@config/site';
import Button from './Button.astro';
import MediaSlot from './MediaSlot.astro';
import { cn } from '@lib/cn';

interface Props {
  person: Professional;
  /** Neutral, factual introduction. Never invented history. */
  intro: string;
  ctaLabel: string;
  seed?: number;
  class?: string;
}

const { person, intro, ctaLabel, seed = 0, class: className } = Astro.props;
---

<article class={cn('group flex flex-col', className)} data-reveal>
  {/*
    Redundant with the named link below, so it is hidden from assistive
    technology and taken out of the tab order: with no portrait supplied the
    MediaSlot's alt is empty, which left this announcing as a link with no name
    (WCAG 2.4.4 / 4.1.2). Still clickable with a mouse.
  */}
  <a href={person.href} class="block overflow-hidden rounded-xs" aria-hidden="true" tabindex="-1">
    <MediaSlot
      src={person.portrait}
      alt={person.portrait ? `${person.name}, ${person.title}` : ''}
      width={720}
      height={900}
      ratio="4/5"
      seed={seed}
      sizes="(min-width: 768px) 45vw, 100vw"
      class="max-h-[30rem]"
      imgClass="transition-transform duration-700 ease-[var(--ease-editorial)] motion-safe:group-hover:scale-[1.03]"
    />
  </a>

  <div class="mt-7 flex flex-1 flex-col">
    <h3 class="text-display-sm text-evergreen-800">
      <a href={person.href} class="link-underline">{person.name}</a>
    </h3>

    <p class="eyebrow mt-3 text-evergreen-600">
      <span class="rule-gold" aria-hidden="true"></span>
      {person.specialty ? `${person.title} · ${person.specialty}` : person.title}
    </p>

    <p class="mt-5 max-w-md leading-relaxed text-ink-muted">{intro}</p>

    <dl class="mt-6 flex flex-col gap-1.5 text-sm">
      <div>
        <dt class="sr-only">Phone</dt>
        <dd>
          <a href={person.phone.href} class="link-underline text-evergreen-800">
            <span class="sr-only">Call {person.firstName} on </span>
            {person.phone.value}
          </a>
        </dd>
      </div>
      <div>
        <dt class="sr-only">Email</dt>
        <dd class="break-all">
          <a href={person.email.href} class="link-underline text-ink-muted">
            <span class="sr-only">Email {person.firstName} at </span>
            {person.email.value}
          </a>
        </dd>
      </div>
    </dl>

    <div class="mt-8">
      <Button href={person.href} variant="secondary" withArrow>{ctaLabel}</Button>
    </div>
  </div>
</article>
