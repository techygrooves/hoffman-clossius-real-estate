---
/**
 * DevelopmentCard — one project in a grid.
 * Speaks only the normalised `Development` type, so it is unaffected by where
 * the record came from.
 */
import type { Development } from '@lib/developments/types';
import { DEVELOPMENT_TYPE_LABELS } from '@lib/developments/query';
import { formatPrice } from '@lib/format';
import { cn } from '@lib/cn';
import MediaSlot from '@components/ui/MediaSlot.astro';
import DevelopmentStatusBadge from './DevelopmentStatusBadge.astro';
import DevelopmentFacts from './DevelopmentFacts.astro';

interface Props {
  development: Development;
  seed?: number;
  headingLevel?: 'h3' | 'h4';
  priority?: boolean;
  class?: string;
}

const {
  development,
  seed = 0,
  headingLevel: Heading = 'h3',
  priority = false,
  class: className,
} = Astro.props;

const primary = development.images[0] ?? null;
const typeLabel =
  development.developmentTypeLabel ??
  DEVELOPMENT_TYPE_LABELS[development.developmentType];
---

<article
  class={cn(
    'group relative flex flex-col overflow-hidden rounded-xs border border-line bg-white',
    'transition-shadow duration-500 ease-[var(--ease-editorial)] hover:shadow-card',
    className,
  )}
  data-development-card
  data-reveal
>
  <div class="relative overflow-hidden">
    <MediaSlot
      src={primary?.url ?? null}
      alt={primary?.alt ?? ''}
      width={primary?.width ?? 800}
      height={primary?.height ?? 600}
      ratio="4/3"
      seed={seed}
      marker={false}
      loading={priority ? 'eager' : 'lazy'}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      imgClass="transition-transform duration-700 ease-[var(--ease-editorial)] motion-safe:group-hover:scale-[1.04]"
    />

    <div class="pointer-events-none absolute left-4 top-4 flex flex-wrap gap-2">
      <DevelopmentStatusBadge status={development.status} />
      {
        primary?.isRendering && (
          <span class="rounded-xs bg-charcoal-900/70 px-2.5 py-1 text-[0.625rem] uppercase tracking-eyebrow text-white backdrop-blur-sm">
            Rendering
          </span>
        )
      }
    </div>

    {
      development.demo && (
        <span class="pointer-events-none absolute right-4 top-4 rounded-xs border border-dashed border-white/60 bg-charcoal-900/70 px-2.5 py-1 text-[0.625rem] uppercase tracking-eyebrow text-white backdrop-blur-sm">
          Sample
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    <p class="text-[0.625rem] uppercase tracking-eyebrow text-evergreen-600">
      {development.city}, {development.address.state} · {typeLabel}
    </p>

    <Heading class="mt-2 font-serif text-2xl leading-snug text-evergreen-800">
      <a
        href={`/developments/${development.slug}/`}
        class="after:absolute after:inset-0 after:content-['']"
      >
        {development.name}
      </a>
    </Heading>

    {
      development.startingPrice !== null && (
        <p class="mt-2 text-sm text-ink">
          From <span class="font-medium">{formatPrice(development.startingPrice)}</span>
        </p>
      )
    }

    {
      development.summary && (
        <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-muted">
          {development.summary}
        </p>
      )
    }

    <DevelopmentFacts
      development={development}
      class="mt-auto border-t border-line pt-4 [&]:mt-5"
    />

    <p class="mt-5 inline-flex items-center gap-2 text-xs uppercase tracking-eyebrow text-evergreen-700">
      View development
      <svg
        class="h-3 w-3 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M1 8h13M9 3l5 5-5 5"></path>
      </svg>
    </p>
  </div>
</article>
