---
/**
 * DevelopmentFilters — the filter panel for a development index.
 *
 * A real GET form: without JavaScript it submits and every filter still lives
 * in the URL, so a filtered view is always shareable. With JavaScript the
 * client filters in place and rewrites the URL.
 *
 * The city list comes from the provider rather than a hardcoded list, so it
 * always reflects what is actually on the page.
 */
import {
  DEV_PARAM,
  DEVELOPMENT_SORT_LABELS,
  DEVELOPMENT_STATUS_LABELS,
  DEVELOPMENT_TYPE_LABELS,
  SELECTABLE_DEVELOPMENT_SORTS,
  SELECTABLE_DEVELOPMENT_TYPES,
} from '@lib/developments/query';
import type {
  DevelopmentQuery,
  DevelopmentStatus,
  DevelopmentType,
} from '@lib/developments/types';
import { cn } from '@lib/cn';

interface Props {
  query: DevelopmentQuery;
  action: string;
  /** Fixed by the route; carried so the client script can read it. */
  category: 'new' | 'existing';
  cities: readonly string[];
  /** Statuses worth offering for this index. */
  statuses: readonly DevelopmentStatus[];
  class?: string;
}

const { query, action, category, cities, statuses, class: className } = Astro.props;

const PRICES = [400000, 600000, 800000, 1000000, 1500000, 2000000, 3000000, 5000000];

const usd = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  notation: 'compact',
  maximumFractionDigits: 1,
});

const field =
  'h-12 w-full rounded-xs border border-line-control bg-white px-3.5 text-sm text-ink placeholder:text-ink-subtle ' +
  'transition-colors hover:border-evergreen-700 focus:border-evergreen-800';
const label = 'block text-xs uppercase tracking-wide-sm text-ink-muted';
const chip =
  'cursor-pointer rounded-xs border border-line-control px-4 py-2 text-sm text-ink-muted transition-colors ' +
  'hover:border-evergreen-700 peer-checked:border-evergreen-800 peer-checked:bg-evergreen-800 peer-checked:text-white';

const isType = (type: DevelopmentType) =>
  query.developmentType?.includes(type) ?? false;
---

<form
  id="development-filters"
  action={action}
  method="get"
  role="search"
  aria-label="Filter developments"
  data-development-filters
  data-category={category}
  class={cn('rounded-xs border border-line bg-white p-6 sm:p-8', className)}
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <label class={label} for="dev-search">Name, developer or area</label>
      <input
        id="dev-search"
        name={DEV_PARAM.search}
        type="search"
        autocomplete="off"
        value={query.search ?? ''}
        placeholder="Search developments…"
        class={`mt-2 ${field}`}
      />
    </div>

    <div class="lg:col-span-3">
      <label class={label} for="dev-city">City</label>
      <select id="dev-city" name={DEV_PARAM.city} class={`mt-2 ${field}`}>
        <option value="">All cities</option>
        {
          cities.map((city) => (
            <option value={city} selected={query.city === city}>{city}</option>
          ))
        }
      </select>
    </div>

    <div class="lg:col-span-2">
      <label class={label} for="dev-min">Min price</label>
      <select id="dev-min" name={DEV_PARAM.minPrice} class={`mt-2 ${field}`}>
        <option value="">No minimum</option>
        {
          PRICES.map((price) => (
            <option value={price} selected={query.minPrice === price}>
              {usd.format(price)}
            </option>
          ))
        }
      </select>
    </div>

    <div class="lg:col-span-2">
      <label class={label} for="dev-max">Max price</label>
      <select id="dev-max" name={DEV_PARAM.maxPrice} class={`mt-2 ${field}`}>
        <option value="">No maximum</option>
        {
          PRICES.map((price) => (
            <option value={price} selected={query.maxPrice === price}>
              {usd.format(price)}
            </option>
          ))
        }
      </select>
    </div>

    <div class="lg:col-span-1">
      <label class={label} for="dev-beds">Beds</label>
      <select id="dev-beds" name={DEV_PARAM.beds} class={`mt-2 ${field}`}>
        <option value="">Any</option>
        {
          [1, 2, 3, 4, 5].map((n) => (
            <option value={n} selected={query.beds === n}>{n}+</option>
          ))
        }
      </select>
    </div>
  </div>

  <details class="group/more mt-5 border-t border-line pt-5" open>
    <summary class="flex cursor-pointer list-none items-center gap-2 text-xs uppercase tracking-wide-sm text-evergreen-800 [&::-webkit-details-marker]:hidden">
      More filters
      <svg
        class="h-2.5 w-2.5 transition-transform duration-300 group-open/more:rotate-180"
        viewBox="0 0 10 6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M1 1l4 4 4-4" />
      </svg>
    </summary>

    <div class="mt-5 grid gap-6 lg:grid-cols-2">
      <fieldset class="border-0 p-0">
        <legend class={label}>Type</legend>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            SELECTABLE_DEVELOPMENT_TYPES.filter((t) => t !== 'other').map((type) => (
              <li>
                <label class="relative inline-flex">
                  <input
                    type="checkbox"
                    name={DEV_PARAM.developmentType}
                    value={type}
                    checked={isType(type)}
                    class="peer sr-only"
                  />
                  <span class={chip}>{DEVELOPMENT_TYPE_LABELS[type]}</span>
                </label>
              </li>
            ))
          }
        </ul>
      </fieldset>

      {
        statuses.length > 1 && (
          <fieldset class="border-0 p-0">
            <legend class={label}>Status</legend>
            <ul class="mt-3 flex flex-wrap gap-2">
              {statuses.map((status) => (
                <li>
                  <label class="relative inline-flex">
                    <input
                      type="checkbox"
                      name={DEV_PARAM.status}
                      value={status}
                      checked={query.status?.includes(status) ?? false}
                      class="peer sr-only"
                    />
                    <span class={chip}>{DEVELOPMENT_STATUS_LABELS[status]}</span>
                  </label>
                </li>
              ))}
            </ul>
          </fieldset>
        )
      }
    </div>
  </details>

  <div class="mt-6 flex flex-col gap-4 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between">
    <a
      href={action}
      data-clear-development-filters
      class="text-xs uppercase tracking-wide-sm text-ink-muted underline-offset-4 transition-colors hover:text-evergreen-800 hover:underline"
    >
      Clear all filters
    </a>

    <div class="flex flex-wrap items-center gap-4">
      <div class="flex items-center gap-3">
        <label for="dev-sort" class="text-xs uppercase tracking-wide-sm text-ink-subtle">
          Sort
        </label>
        <select
          id="dev-sort"
          name={DEV_PARAM.sort}
          data-development-sort
          class="h-11 rounded-xs border border-line-control bg-white px-3 text-sm text-ink transition-colors hover:border-evergreen-700 focus:border-evergreen-800"
        >
          {
            SELECTABLE_DEVELOPMENT_SORTS.map((option) => (
              <option value={option} selected={query.sort === option}>
                {DEVELOPMENT_SORT_LABELS[option]}
              </option>
            ))
          }
        </select>
      </div>

      <button
        type="submit"
        class="group inline-flex h-12 items-center justify-center gap-2.5 rounded-xs border border-evergreen-800 bg-evergreen-800 px-8 text-sm font-medium tracking-wide-sm text-white transition-all duration-300 ease-[var(--ease-editorial)] hover:bg-evergreen-900 hover:shadow-card motion-safe:active:translate-y-px"
      >
        Filter
        <svg
          class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <path d="M1 8h13M9 3l5 5-5 5"></path>
        </svg>
      </button>
    </div>
  </div>
</form>
