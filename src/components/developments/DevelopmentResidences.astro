---
/**
 * DevelopmentResidences — the residence types within a project, and the
 * floor-plan slot for each.
 *
 * ── On floor plans ────────────────────────────────────────────────────────
 * Floor plans are copyrighted developer material. They are **never drawn,
 * approximated, reconstructed from a description, or downloaded from a
 * developer's website.** `residence.floorPlan` is a slot for an asset the
 * client has written permission to publish; until one exists, the card says
 * plans are available on request and offers a person to ask.
 *
 * That is a deliberate design decision, not a gap: a made-up floor plan on a
 * real estate site is a misrepresentation of someone's home.
 */
import type { Development, NumericRange, ResidenceType } from '@lib/developments/types';
import { formatNumber, formatPrice } from '@lib/format';
import MediaSlot from '@components/ui/MediaSlot.astro';
import { cn } from '@lib/cn';

interface Props {
  development: Development;
  class?: string;
}

const { development, class: className } = Astro.props;
const residences = development.residences;

function rangeText(range: NumericRange, format: (n: number) => string = String): string | null {
  const { min, max } = range;
  if (min === null && max === null) return null;
  if (min !== null && max !== null) {
    return min === max ? format(min) : `${format(min)}–${format(max)}`;
  }
  return min !== null ? `From ${format(min)}` : `Up to ${format(max as number)}`;
}

/** Only the facts this residence actually carries. */
const specs = (residence: ResidenceType) =>
  [
    residence.beds !== null && { label: residence.beds === 1 ? 'Bed' : 'Beds', value: String(residence.beds) },
    residence.baths !== null && {
      label: 'Baths',
      value: residence.halfBaths
        ? `${residence.baths}.${residence.halfBaths}`
        : String(residence.baths),
    },
    rangeText(residence.sqft, formatNumber) && {
      label: 'Sq Ft',
      value: rangeText(residence.sqft, formatNumber) as string,
    },
  ].filter((s): s is { label: string; value: string } => Boolean(s));

const enquiryHref = (residence: ResidenceType) =>
  `/contact/?${new URLSearchParams({
    intent: 'information',
    property: `${development.name} — ${residence.name}`,
    reference: development.slug,
  }).toString()}`;
---

{
  residences.length > 0 && (
    <div class={cn('flex flex-col gap-4', className)}>
      {residences.map((residence, index) => (
        <article class="grid gap-6 rounded-xs border border-line bg-white p-6 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-start">
          {/* Floor-plan slot. Never a manufactured drawing. */}
          <div class="overflow-hidden rounded-xs border border-line">
            <MediaSlot
              src={residence.floorPlan?.url ?? null}
              alt={residence.floorPlan?.alt ?? ''}
              width={residence.floorPlan?.width ?? 600}
              height={residence.floorPlan?.height ?? 600}
              ratio="1/1"
              seed={index}
              marker={false}
              sizes="12rem"
            />
          </div>

          <div class="min-w-0">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-serif text-2xl text-evergreen-800">{residence.name}</h3>
              {residence.priceFrom !== null && (
                <p class="text-sm text-ink">
                  From <span class="font-medium">{formatPrice(residence.priceFrom)}</span>
                </p>
              )}
            </div>

            {specs(residence).length > 0 && (
              <dl class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                {specs(residence).map((spec) => (
                  <div class="flex items-baseline gap-1.5">
                    <dd class="font-medium text-evergreen-800">{spec.value}</dd>
                    <dt class="text-xs uppercase tracking-wide-sm text-ink-subtle">
                      {spec.label}
                    </dt>
                  </div>
                ))}
              </dl>
            )}

            {residence.availability && (
              <p class="mt-3 text-sm text-ink-muted">{residence.availability}</p>
            )}

            <p class="mt-5 text-xs text-ink-muted">
              {residence.floorPlan
                ? 'Floor plan shown. Dimensions are approximate and subject to change.'
                : 'Floor plans are available on request.'}
            </p>

            <a
              href={enquiryHref(residence)}
              class="link-underline mt-3 inline-block text-xs uppercase tracking-eyebrow text-evergreen-700"
            >
              Ask about {residence.name}
            </a>
          </div>
        </article>
      ))}
    </div>
  )
}
