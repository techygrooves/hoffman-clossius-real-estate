---
/**
 * DevelopmentMap — where the development is.
 *
 * PLACEHOLDER: no map provider has been chosen (CONTENT_PENDING.md 11.4), so
 * this shows the location in words rather than drawing a map we cannot source.
 * When a provider is chosen, the embed replaces the MediaSlot below and
 * nothing else on the page changes — `latitude` and `longitude` are already
 * carried on every record.
 */
import type { Development } from '@lib/developments/types';
import MediaSlot from '@components/ui/MediaSlot.astro';
import { cn } from '@lib/cn';

interface Props {
  development: Development;
  class?: string;
}

const { development, class: className } = Astro.props;

const { address } = development;
const lines = [
  address.line1,
  [address.city, address.state, address.zip].filter(Boolean).join(', '),
  address.county,
].filter((line): line is string => Boolean(line));
---

<div class={cn('overflow-hidden rounded-xs border border-line', className)}>
  <MediaSlot src={null} width={1200} height={600} ratio="2/1" seed={2} marker={false} />
  <div class="border-t border-line bg-white px-6 py-5">
    <address class="text-sm not-italic leading-relaxed text-evergreen-800">
      {lines.map((line, index) => (
        <span class={index === 0 ? '' : 'block text-ink-muted'}>{line}</span>
      ))}
    </address>
    <p class="mt-3 text-xs text-ink-subtle">
      An interactive map is added once a map provider is chosen.
    </p>
  </div>
</div>
