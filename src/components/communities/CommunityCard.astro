---
/**
 * CommunityCard — one community on the index or a cross-link grid.
 *
 * Shows the name, its county, its parent municipality when it is a subarea,
 * and the single factual line from the data file. Nothing else, because
 * nothing else has been supplied — no price band, no "popular for", no rating.
 *
 * Carries a compact JSON payload so the client filter can show and hide it
 * without re-rendering any markup.
 */
import MediaSlot from '@components/ui/MediaSlot.astro';
import type { Community } from '@data/communities';
import { cn } from '@lib/cn';

interface Props {
  community: Community;
  /** Resolved by the caller so this component stays free of lookups. */
  parentName?: string | null;
  seed?: number;
  /** `feature` is the taller treatment used on the index's featured row. */
  variant?: 'default' | 'feature';
  class?: string;
}

const {
  community,
  parentName = null,
  seed = 0,
  variant = 'default',
  class: className,
} = Astro.props;

const isFeature = variant === 'feature';

/** Only the fields `matchesCommunity` reads. */
const payload = JSON.stringify({
  slug: community.slug,
  name: community.name,
  county: community.county,
  kind: community.kind,
  parent: community.parent,
  parentName,
});

/* Same reasoning as CommunitiesGrid: the dark scrim exists to keep type legible
   over a photograph, and no photography has been supplied. Without this the
   whole /communities/ index renders as a wall of evergreen. */
const hasPhoto = Boolean(community.heroImage?.src);
---

<li data-community={payload} class={cn('min-w-0', className)}>
  <a
    href={`/communities/${community.slug}/`}
    class={cn(
      'group relative isolate flex h-full flex-col overflow-hidden rounded-sm',
      'transition-[transform,box-shadow] duration-500 ease-[var(--ease-editorial)]',
      'motion-safe:hover:-translate-y-1 hover:shadow-card',
      hasPhoto
        ? 'bg-evergreen-900 text-white'
        : 'border border-line bg-cream-50 text-ink hover:border-evergreen-800/30',
      isFeature ? 'min-h-[24rem] sm:min-h-[28rem]' : 'min-h-[18rem]',
    )}
    data-surface={hasPhoto ? 'dark' : undefined}
  >
    <span class="absolute inset-0 -z-10">
      <MediaSlot
        src={community.heroImage?.src ?? null}
        alt=""
        width={800}
        height={1000}
        ratio="auto"
        tone={hasPhoto ? 'deep' : 'light'}
        seed={seed}
        marker={false}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="h-full w-full"
        imgClass="transition-transform duration-700 ease-[var(--ease-editorial)] motion-safe:group-hover:scale-[1.04]"
      />
    </span>

    {/* Scrim, so the text keeps its contrast over any photograph. Only when
        there is one — there is nothing to darken otherwise. */}
    {hasPhoto && (
      <span
        class="absolute inset-0 -z-10 bg-gradient-to-t from-evergreen-900 via-evergreen-900/70 to-evergreen-900/25"
        aria-hidden="true"
      />
    )}

    <span class="mt-auto flex flex-col p-6 sm:p-7">
      <span class={cn('text-xs uppercase tracking-eyebrow', hasPhoto ? 'text-white/70' : 'text-gold-700')}>
        {community.parent && parentName ? `${parentName} · ${community.county}` : community.county}
      </span>
      <span
        class={cn(
          'mt-2 font-serif',
          hasPhoto ? 'text-white' : 'text-evergreen-800',
          isFeature ? 'text-3xl' : 'text-2xl',
        )}
      >
        {community.name}
      </span>
      <span class={cn('mt-3 text-sm leading-relaxed', hasPhoto ? 'text-white/75' : 'text-ink-muted')}>
        {community.shortDescription}
      </span>
      <span class={cn('mt-5 inline-flex items-center gap-2 text-xs uppercase tracking-eyebrow', hasPhoto ? 'text-gold-300' : 'text-evergreen-700')}>
        Explore {community.name}
        <svg
          class="h-3 w-3 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <path d="M1 8h13M9 3l5 5-5 5"></path>
        </svg>
      </span>
    </span>
  </a>
</li>
