---
/**
 * CommunityCtas — buyer, seller and relocation routes out of a community page.
 *
 * Three specific next steps rather than one generic "contact us". Each says
 * what it costs and what it commits you to, because both answers are
 * "nothing" and most sites leave a visitor to guess.
 *
 * No promise about response time appears here: nobody has told us what Martin
 * and MaryEllen can commit to, and "we reply within an hour" is the sort of
 * thing a website says and a person then has to live up to.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import type { Community } from '@data/communities';

interface Props {
  community: Community;
  searchHref: string;
  id: string;
  tone?: 'white' | 'warm';
}

const { community, searchHref, id, tone = 'white' } = Astro.props;

const ROUTES = [
  {
    eyebrow: 'Buying',
    title: `Looking in ${community.name}`,
    body: `Search what is available now, or tell us what you are after and hear about it as it comes to market — including the things that never reach a portal.`,
    primary: { label: 'Search homes', href: searchHref },
    secondary: { label: 'Dream Home Finder', href: '/buy/dream-home-finder/' },
  },
  {
    eyebrow: 'Selling',
    title: `Selling in ${community.name}`,
    body: 'An opinion of value prepared by Martin or MaryEllen, from what genuinely comparable homes nearby sold for. No cost, no obligation, and no number generated by this website.',
    primary: { label: 'Request a home evaluation', href: '/sell/home-evaluation/' },
    secondary: { label: 'How selling works', href: '/sell/' },
  },
  {
    eyebrow: 'Relocating',
    title: 'Moving from out of state',
    body: 'Choosing an area you have not lived in is a different exercise, and most people get one or two trips to decide. Worth a conversation before you start looking.',
    primary: { label: 'Relocation guide', href: '/relocation/' },
    secondary: { label: 'Meet MaryEllen', href: '/about/maryellen-closius/' },
  },
];
---

<Section tone={tone} labelledby={id}>
  <SectionHeader
    id={id}
    eyebrow="Next steps"
    title={`Whatever brought you to ${community.name}`}
  />

  <ul class="mt-12 grid gap-6 lg:grid-cols-3">
    {
      ROUTES.map((route, index) => (
        <li
          class="flex h-full flex-col rounded-xs border border-line bg-cream-50 p-7"
          data-reveal
          style={`--reveal-delay:${index * 60}ms`}
        >
          <p class="eyebrow text-evergreen-600">
            <span class="rule-gold" aria-hidden="true" />
            {route.eyebrow}
          </p>
          <h3 class="mt-4 font-serif text-2xl text-evergreen-800">{route.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{route.body}</p>
          <div class="mt-6 flex flex-col gap-2 border-t border-line pt-5 text-sm">
            <a href={route.primary.href} class="link-underline text-evergreen-800">
              {route.primary.label}
            </a>
            <a href={route.secondary.href} class="link-underline text-ink-muted">
              {route.secondary.label}
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
