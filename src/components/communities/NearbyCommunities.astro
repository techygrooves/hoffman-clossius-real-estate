---
/**
 * NearbyCommunities — cross-links to other guides.
 *
 * Ordered by geography: the parent municipality, then sibling subareas, then
 * other communities in the same county. Deliberately NOT "similar
 * communities" — similarity is a judgement about price, character and who
 * lives there, and nobody has made it.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import type { Community } from '@data/communities';

interface Props {
  communities: readonly Community[];
  /** Resolved parent names, keyed by slug. */
  parentNames: Record<string, string | null>;
  id: string;
  tone?: 'white' | 'warm';
}

const { communities, parentNames, id, tone = 'white' } = Astro.props;
---

{
  communities.length > 0 && (
    <Section tone={tone} labelledby={id}>
      <SectionHeader
        id={id}
        eyebrow="Nearby"
        title="Other communities close by"
        lead="Ordered by where they sit, not by how alike they are — that is a judgement for a conversation."
      />

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {communities.map((community, index) => (
          <li>
            <a
              href={`/communities/${community.slug}/`}
              class="group flex h-full flex-col rounded-xs border border-line p-6 transition-shadow duration-500 hover:shadow-card"
              data-reveal
              style={`--reveal-delay:${index * 60}ms`}
            >
              <span class="text-xs uppercase tracking-eyebrow text-ink-subtle">
                {community.parent && parentNames[community.slug]
                  ? parentNames[community.slug]
                  : community.county}
              </span>
              <span class="mt-3 font-serif text-xl text-evergreen-800">
                {community.name}
              </span>
              <span class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
                {community.shortDescription}
              </span>
              <span class="mt-5 inline-flex items-center gap-2 text-xs uppercase tracking-eyebrow text-evergreen-700">
                View guide
                <svg
                  class="h-3 w-3 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                  aria-hidden="true"
                >
                  <path d="M1 8h13M9 3l5 5-5 5" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex" data-reveal>
        <Button href="/communities/" variant="secondary" withArrow>
          All communities
        </Button>
      </div>
    </Section>
  )
}
