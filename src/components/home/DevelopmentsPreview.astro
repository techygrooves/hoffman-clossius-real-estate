---
/**
 * DevelopmentsPreview — the New Developments band on the homepage.
 *
 * Data comes from the development provider: client-supplied projects when they
 * exist, clearly-labelled demo records in development, and an honest
 * invitation otherwise. Nothing about a project is ever written here.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import DemoNotice from '@components/ui/DemoNotice.astro';
import DevelopmentGrid from '@components/developments/DevelopmentGrid.astro';
import { developmentProvider } from '@lib/developments/provider';

const developments = (await developmentProvider.search({ category: 'new' })).slice(0, 3);
---

<Section tone="sage" labelledby="developments-heading">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <SectionHeader
      id="developments-heading"
      eyebrow="New construction"
      title="New Developments"
      lead="Pre-construction and newly delivered communities across South Florida."
    />
    <div class="hidden shrink-0 md:block" data-reveal>
      <Button href="/developments/new/" variant="secondary" withArrow>
        Explore New Developments
      </Button>
    </div>
  </div>

  {developmentProvider.isDemo && <DemoNotice class="mt-8" what="developments" />}

  <DevelopmentGrid
    developments={developments}
    emptyVariant="not-supplied"
    category="new"
    class="mt-12"
  />

  <div class="mt-10 md:hidden" data-reveal>
    <Button href="/developments/new/" variant="secondary" block withArrow>
      Explore New Developments
    </Button>
  </div>
</Section>
