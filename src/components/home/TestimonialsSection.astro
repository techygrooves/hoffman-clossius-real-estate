---
/**
 * TestimonialsSection — client words.
 *
 * Renders ONLY entries in src/data/testimonials.ts marked `verified: true`,
 * meaning the client has confirmed the quote is real and may be published.
 * There is no demo mode here and there never will be: a fabricated review is
 * unacceptable in every environment (PROJECT_CONTEXT.md §9).
 *
 * With nothing verified, the section renders a neutral shell — the design is
 * reviewable, and no words are put in anyone's mouth.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import { resolveTestimonials } from '@lib/content';
import { formatDate } from '@lib/format';

const { items } = resolveTestimonials(3);
---

<Section tone="warm" labelledby="testimonials-heading">
  <SectionHeader
    id="testimonials-heading"
    eyebrow="Client experience"
    title="In their own words"
    align="center"
  />

  {
    items.length > 0 ? (
      <ul class="mt-14 grid gap-6 lg:grid-cols-3">
        {items.map((testimonial, index) => (
          <li>
            <figure
              class="flex h-full flex-col rounded-xs border border-line bg-white p-8"
              data-reveal
              style={`--reveal-delay:${index * 80}ms`}
            >
              <svg
                class="h-6 w-6 shrink-0 text-gold-500"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M9.6 5.4A6.6 6.6 0 0 0 3 12v6.6h6.6V12H6.3a3.3 3.3 0 0 1 3.3-3.3V5.4Zm11.4 0A6.6 6.6 0 0 0 14.4 12v6.6H21V12h-3.3A3.3 3.3 0 0 1 21 8.7V5.4Z" />
              </svg>
              <blockquote class="mt-6 flex-1">
                <p class="font-serif text-xl leading-relaxed text-evergreen-800">
                  {testimonial.quote}
                </p>
              </blockquote>
              <figcaption class="mt-6 border-t border-line pt-5 text-sm">
                <span class="block text-evergreen-800">{testimonial.attribution}</span>
                {testimonial.context && (
                  <span class="mt-0.5 block text-xs text-ink-muted">
                    {testimonial.context}
                  </span>
                )}
                {(testimonial.source || testimonial.date) && (
                  <span class="mt-2 block text-xs text-ink-subtle">
                    {testimonial.sourceUrl ? (
                      <a
                        href={testimonial.sourceUrl}
                        rel="noopener noreferrer"
                        target="_blank"
                        class="link-underline"
                      >
                        {testimonial.source}
                      </a>
                    ) : (
                      testimonial.source
                    )}
                    {testimonial.source && testimonial.date && ' · '}
                    {formatDate(testimonial.date)}
                  </span>
                )}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    ) : (
      <div
        class="mx-auto mt-14 max-w-2xl rounded-xs border border-dashed border-line-strong bg-white px-8 py-14 text-center"
        data-reveal
      >
        <svg
          class="mx-auto h-6 w-6 text-gold-500"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M9.6 5.4A6.6 6.6 0 0 0 3 12v6.6h6.6V12H6.3a3.3 3.3 0 0 1 3.3-3.3V5.4Zm11.4 0A6.6 6.6 0 0 0 14.4 12v6.6H21V12h-3.3A3.3 3.3 0 0 1 21 8.7V5.4Z" />
        </svg>
        <p class="mt-6 font-serif text-2xl text-evergreen-800">
          Client testimonials are published here once they are confirmed.
        </p>
        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-ink-muted">
          We only publish words people have actually said, with their
          permission. Nothing here is written on their behalf.
        </p>
      </div>
    )
  }

  <div class="mt-12 flex justify-center" data-reveal>
    <Button href="/testimonials/" variant="secondary" withArrow>
      Read Client Testimonials
    </Button>
  </div>
</Section>
