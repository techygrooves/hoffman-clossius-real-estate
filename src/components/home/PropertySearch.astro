---
/**
 * PropertySearch — the search module beneath the hero.
 *
 * ── What changed, and why ─────────────────────────────────────────────────
 * This used to be a full filter form — location, price, beds, baths, type —
 * that submitted to `/properties/search/`. Every field worked; the page it
 * submitted to had no listings behind it, because no MLS feed has ever been
 * connected. So a visitor filled in six fields and got nothing. That is what
 * the client meant by "the search bar is not working".
 *
 * The client supplied their live search on 2026-10-16
 * (`propertySearch.url` in src/config/site.ts), so this now takes people
 * straight there.
 *
 * ── Why there is no text field ────────────────────────────────────────────
 * The destination is an external platform whose query vocabulary we have not
 * been given, and the site cannot reach it from here to find out. A box that
 * takes what someone types and then drops it on the floor is worse than no
 * box: they would arrive at an unfiltered list believing they had searched
 * for Hollywood. So this is an honest, prominent way IN to the search, and
 * the typing happens there, where it works.
 *
 * Restore filters here the moment the destination's parameter names are
 * confirmed — see IDX_INTEGRATION.md.
 */
import Container from '@components/ui/Container.astro';
import { propertySearch } from '@config/site';

/** Routes that do work on this site today, for people who want a way to browse. */
const BROWSE = [
  { label: 'Our listings', href: '/properties/our-listings/' },
  { label: 'New developments', href: '/developments/new/' },
  { label: 'Communities', href: '/communities/' },
];
---

<section
  class="relative z-10 bg-cream-100 pb-16 pt-12 sm:pb-20"
  aria-labelledby="property-search-heading"
>
  <Container>
    <div
      class="rounded-xs border border-line bg-white p-6 shadow-card sm:p-8 lg:-mt-24 lg:p-10"
      data-reveal
    >
      <span class="rule-gold" aria-hidden="true"></span>

      <h2 id="property-search-heading" class="mt-5 text-display-sm text-evergreen-800">
        Find your place in South Florida
      </h2>

      <p class="mt-3 max-w-xl leading-relaxed text-ink-muted">
        Every active listing across Broward, Palm Beach and Miami-Dade, with
        filters for location, price, bedrooms and property type.
      </p>

      {/*
        One link, styled as a search bar. The whole bar is the target, so
        there is no small hit area to aim at on a phone, and `group-hover`
        lights the action block from anywhere inside it.

        It is deliberately a link rather than a form: it reads as something
        you press, not something you type into, which is the truth of it.
      */}
      <a
        href={propertySearch.url}
        data-search-cta
        class="group mt-7 flex min-h-14 w-full items-stretch overflow-hidden rounded-xs border border-line-control bg-white transition-all duration-300 ease-[var(--ease-editorial)] hover:border-evergreen-800 hover:shadow-card focus-visible:border-evergreen-800 motion-safe:active:translate-y-px"
      >
        <span class="flex flex-1 items-center gap-3 px-4 py-3.5 sm:gap-4 sm:px-5">
          <svg
            class="h-5 w-5 shrink-0 text-evergreen-700"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-4-4"></path>
          </svg>
          {/*
            Weighted and coloured as an action, not as placeholder grey. The
            bar is shaped like a search field because that is the shape people
            look for, but nothing here accepts typing, so it must not read as
            an empty box waiting for a caret.
          */}
          <span
            class="text-left text-sm font-medium leading-snug text-evergreen-800 sm:text-base"
          >
            Search all South Florida listings
            <span class="sr-only"> — {propertySearch.srSuffix}</span>
          </span>
        </span>

        <span
          class="flex shrink-0 items-center gap-2.5 self-stretch bg-evergreen-800 px-5 text-sm font-medium tracking-wide-sm text-white transition-colors duration-300 group-hover:bg-evergreen-900 sm:px-8"
          aria-hidden="true"
        >
          <span class="hidden sm:inline">Search</span>
          <svg
            class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"
          >
            <path d="M1 8h13M9 3l5 5-5 5"></path>
          </svg>
        </span>
      </a>

      <div
        class="mt-6 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="text-xs leading-relaxed text-ink-muted">
          Or browse what we are working on right now:
        </p>

        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
          {
            BROWSE.map((item) => (
              <li>
                <a href={item.href} class="link-underline text-evergreen-800">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>
