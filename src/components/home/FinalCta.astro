---
/**
 * FinalCta — the closing band. Two actions and two real phone numbers.
 */
import Section from '@components/ui/Section.astro';
import Button from '@components/ui/Button.astro';
import { professionals } from '@config/site';
---

<Section tone="deep" labelledby="final-cta-heading">
  <div class="mx-auto flex max-w-3xl flex-col items-center text-center" data-reveal>
    <span class="rule-gold" aria-hidden="true"></span>

    <h2 id="final-cta-heading" class="mt-7 text-display text-white">
      Your South Florida Real Estate Journey Starts Here.
    </h2>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <Button href="/contact/" size="lg" variant="gold" withArrow>Contact Us</Button>
      <Button href="/properties/search/" size="lg" variant="inverse">
        Search Homes
      </Button>
    </div>
  </div>

  <ul
    class="mx-auto mt-16 grid max-w-3xl gap-px overflow-hidden rounded-xs border border-line-inverse bg-line-inverse sm:grid-cols-2"
    data-reveal
    style="--reveal-delay:100ms"
  >
    {
      professionals.map((person) => (
        <li class="bg-evergreen-800">
          <a
            href={person.phone.href}
            class="group flex h-full flex-col gap-1 px-7 py-7 transition-colors hover:bg-evergreen-900"
          >
            <span class="font-serif text-xl text-white">{person.name}</span>
            <span class="text-[0.625rem] uppercase tracking-eyebrow text-gold-300">
              {person.specialty
                ? `${person.title} · ${person.specialty}`
                : person.title}
            </span>
            <span class="mt-3 inline-flex items-center gap-2.5 text-lg tracking-wide-sm text-white/90">
              <svg
                class="h-4 w-4 shrink-0 text-white/50"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 4h3.5l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L14 13l4 1.5V18a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 4 6.2 2 2 0 0 1 6 4" />
              </svg>
              <span class="sr-only">Call {person.firstName} on </span>
              {person.phone.value}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
