---
/**
 * FeaturedListings — the homepage property grid.
 *
 * Data comes from the listing provider, never from markup: real listings when
 * an authorised feed is connected, clearly-labelled demo records when the demo
 * flag is on, and an honest empty state otherwise. A production build with no
 * MLS feed shows the empty state — it never invents inventory.
 */
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import DemoNotice from '@components/ui/DemoNotice.astro';
import ListingGrid from '@components/listings/ListingGrid.astro';
import { listingProvider, hasListingData } from '@lib/listings/provider';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  limit?: number;
  tone?: 'white' | 'warm';
}

const {
  eyebrow = 'Featured',
  title = 'Selected properties',
  lead,
  limit = 3,
  tone = 'white',
} = Astro.props;

// A wider slice than we show, so our own listings can be preferred without a
// second request.
const result = await listingProvider.search({
  status: ['for-sale', 'coming-soon'],
  sort: 'newest',
  pageSize: 24,
  page: 1,
});

const items = [...result.listings]
  .sort((a, b) => {
    const rank = (l: typeof a) => (l.listingAgent?.isOurAgent ? 0 : 1);
    return rank(a) - rank(b);
  })
  .slice(0, limit);
---

<Section tone={tone} labelledby="featured-listings-heading">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <SectionHeader
      id="featured-listings-heading"
      eyebrow={eyebrow}
      title={title}
      lead={lead}
    />
    <div class="hidden shrink-0 md:block" data-reveal>
      <Button href="/properties/our-listings/" variant="secondary" withArrow>
        View Our Listings
      </Button>
    </div>
  </div>

  {listingProvider.isDemo && <DemoNotice class="mt-8" what="properties" />}

  <ListingGrid
    listings={items}
    emptyVariant={hasListingData ? 'no-results' : 'not-configured'}
    class="mt-12"
  />

  <div class="mt-10 flex flex-wrap gap-3 md:justify-center" data-reveal>
    <div class="md:hidden">
      <Button href="/properties/our-listings/" variant="secondary" withArrow>
        View Our Listings
      </Button>
    </div>
    <Button href="/properties/search/" variant="ghost" withArrow>
      Search All Properties
    </Button>
  </div>
</Section>

<script>
  import { initFavorites } from '@lib/listings/favorites';
  initFavorites();
</script>
