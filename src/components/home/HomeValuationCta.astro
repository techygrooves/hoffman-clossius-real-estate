---
/**
 * HomeValuationCta — the strongest single call to action on the page.
 *
 * The form carries the address to /sell/home-evaluation/ as a query parameter.
 * It does NOT estimate a value: an automated number would be a claim about a
 * real property. Valuations are prepared by Martin and MaryEllen.
 */
import Container from '@components/ui/Container.astro';
---

<section
  class="relative isolate overflow-hidden bg-evergreen-800 text-white"
  data-surface="dark"
  aria-labelledby="valuation-heading"
>
  {/* Restrained gold arc, the one decorative flourish in this band. */}
  <svg
    class="pointer-events-none absolute -right-24 -top-24 h-[28rem] w-[28rem] opacity-[0.16]"
    viewBox="0 0 400 400"
    fill="none"
    stroke="#C9A34A"
    stroke-width="1"
    aria-hidden="true"
  >
    <circle cx="200" cy="200" r="190" />
    <circle cx="200" cy="200" r="150" />
    <circle cx="200" cy="200" r="110" />
    <circle cx="200" cy="200" r="70" />
  </svg>

  <Container class="section-space relative">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-20">
      <div data-reveal>
        <p class="eyebrow text-gold-300">
          <span class="rule-gold" aria-hidden="true"></span>
          Home valuation
        </p>
        <h2 id="valuation-heading" class="mt-5 text-display-sm text-white">
          Curious What Your Home Is Worth?
        </h2>
        <p class="mt-5 max-w-lg leading-relaxed text-white/75">
          Send us the address and we will come back to you with a considered
          opinion of value — prepared by Martin or MaryEllen, not generated by
          a calculator.
        </p>
      </div>

      <form
        action="/sell/home-evaluation/"
        method="get"
        class="flex flex-col gap-4"
        data-reveal
        style="--reveal-delay:100ms"
      >
        <div>
          <label
            for="valuation-address"
            class="block text-xs uppercase tracking-wide-sm text-white/70"
          >
            Property address
          </label>
          <input
            id="valuation-address"
            name="address"
            type="text"
            autocomplete="street-address"
            placeholder="Street address, city"
            aria-describedby="valuation-hint"
            class="mt-2 h-14 w-full rounded-xs border border-line-control-inverse bg-white/5 px-4 text-white placeholder:text-white/60 transition-colors hover:border-white/70 focus:border-white"
          />
          <p id="valuation-hint" class="mt-2 text-xs text-white/55">
            We will confirm the details with you before preparing anything.
          </p>
        </div>

        <button
          type="submit"
          class="group inline-flex h-14 items-center justify-center gap-2.5 rounded-xs border border-gold-500 bg-gold-500 px-8 text-sm font-medium tracking-wide-sm text-evergreen-900 transition-all duration-300 ease-[var(--ease-editorial)] hover:border-gold-400 hover:bg-gold-400 hover:shadow-card motion-safe:active:translate-y-px"
        >
          Get My Home Value
          <svg
            class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"
            aria-hidden="true"
          >
            <path d="M1 8h13M9 3l5 5-5 5"></path>
          </svg>
        </button>
      </form>
    </div>
  </Container>
</section>
