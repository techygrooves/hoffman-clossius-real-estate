---
/**
 * InsightsSection — the three most recent journal articles.
 *
 * Driven by the `blog` content collection. Articles are written with the
 * client; none are generated, so with an empty collection this renders an
 * honest empty state rather than filler.
 */
import { getCollection } from 'astro:content';
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';
import { formatDate, toISODate } from '@lib/format';
import { getProfessional } from '@config/site';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<Section tone="warm" labelledby="insights-heading">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <SectionHeader
      id="insights-heading"
      eyebrow="Journal"
      title="South Florida Real Estate Insights"
    />
    <div class="hidden shrink-0 md:block" data-reveal>
      <Button href="/blog/" variant="secondary" withArrow>View All Insights</Button>
    </div>
  </div>

  {
    posts.length > 0 ? (
      <ul class="mt-12 grid gap-8 md:grid-cols-3">
        {posts.map((post, index) => {
          const author = getProfessional(post.data.author);
          return (
            <li>
              <article
                class="group flex h-full flex-col"
                data-reveal
                style={`--reveal-delay:${index * 70}ms`}
              >
                <a href={`/blog/${post.id}/`} class="block overflow-hidden rounded-xs">
                  <MediaSlot
                    src={post.data.heroImage?.src ?? null}
                    alt={post.data.heroImage?.alt ?? ''}
                    width={800}
                    height={520}
                    ratio="16/10"
                    seed={index}
                    marker={false}
                    sizes="(min-width: 768px) 33vw, 100vw"
                    imgClass="transition-transform duration-700 ease-[var(--ease-editorial)] motion-safe:group-hover:scale-[1.04]"
                  />
                </a>

                <p class="mt-5 flex flex-wrap items-center gap-x-3 text-[0.625rem] uppercase tracking-eyebrow text-evergreen-600">
                  <span>{post.data.category}</span>
                  <span aria-hidden="true" class="text-ink-subtle">·</span>
                  <time datetime={toISODate(post.data.publishedAt)} class="text-ink-subtle">
                    {formatDate(post.data.publishedAt)}
                  </time>
                </p>

                <h3 class="mt-3 font-serif text-2xl leading-snug text-evergreen-800">
                  <a href={`/blog/${post.id}/`} class="link-underline">
                    {post.data.title}
                  </a>
                </h3>

                <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">
                  {post.data.description}
                </p>

                {author && (
                  <p class="mt-4 text-xs text-ink-subtle">By {author.name}</p>
                )}
              </article>
            </li>
          );
        })}
      </ul>
    ) : (
      <div
        class="mt-12 rounded-xs border border-dashed border-line-strong bg-white px-8 py-14 text-center"
        data-reveal
      >
        <p class="mx-auto max-w-lg font-serif text-2xl text-evergreen-800">
          Market notes and neighbourhood writing are on the way.
        </p>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-ink-muted">
          Articles are written by Martin and MaryEllen. The first pieces will
          appear here.
        </p>
      </div>
    )
  }

  <div class="mt-10 md:hidden" data-reveal>
    <Button href="/blog/" variant="secondary" block withArrow>View All Insights</Button>
  </div>
</Section>
