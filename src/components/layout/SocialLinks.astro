---
/**
 * SocialLinks — renders the social profile icons.
 *
 * Renders NOTHING until a URL is actually confirmed in
 * `pending.social` (src/config/site.ts). The markup slot exists so the icons
 * drop straight into the header and footer the moment the client supplies
 * their profiles — but no URL is ever guessed or constructed from a handle.
 * Tracked in CONTENT_PENDING.md §7.
 */
import { activeSocialLinks } from '@config/site';
import { cn } from '@lib/cn';

interface Props {
  tone?: 'dark' | 'light';
  size?: number;
  class?: string;
}

const { tone = 'dark', size = 16, class: className } = Astro.props;
const isLight = tone === 'light';

/** Accessible names and glyphs, keyed to `pending.social`. */
const PROFILES: Record<string, { label: string; path: string }> = {
  facebook: {
    label: 'Facebook',
    path: 'M15 3h-2.5A4.5 4.5 0 0 0 8 7.5V10H5.5v3H8v8h3v-8h2.5l.5-3H11V7.5a1 1 0 0 1 1-1h3V3Z',
  },
  instagram: {
    label: 'Instagram',
    path: 'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm4.5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5-1.5v.01',
  },
  linkedin: {
    label: 'LinkedIn',
    path: 'M4.5 9v11M4.5 4.5v.01M10 20V9m0 4.5a4 4 0 0 1 8 0V20',
  },
  youtube: {
    label: 'YouTube',
    path: 'M2.5 8.5a3 3 0 0 1 3-3h13a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3h-13a3 3 0 0 1-3-3v-7ZM10 9.5l5 2.5-5 2.5v-5Z',
  },
  x: { label: 'X', path: 'M4 4l16 16M20 4L4 20' },
};
---

{
  activeSocialLinks.length > 0 && (
    <ul class={cn('flex items-center gap-1', className)}>
      {activeSocialLinks.map(({ key, href }) => {
        const profile = PROFILES[key];
        if (!profile) return null;
        return (
          <li>
            <a
              href={href}
              rel="noopener noreferrer"
              target="_blank"
              class={cn(
                'flex h-9 w-9 items-center justify-center rounded-xs transition-colors',
                isLight
                  ? 'text-white/70 hover:bg-white/10 hover:text-white'
                  : 'text-evergreen-700 hover:bg-evergreen-50 hover:text-evergreen-800',
              )}
            >
              <span class="sr-only">{profile.label} — opens in a new tab</span>
              <svg
                width={size}
                height={size}
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={profile.path} />
              </svg>
            </a>
          </li>
        );
      })}
    </ul>
  )
}
