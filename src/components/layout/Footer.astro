---
/**
 * Footer — global site footer.
 *
 * Anything the client has not confirmed (office address, social profiles,
 * brokerage legal wording, Fair Housing disclosure, licence numbers) renders
 * as nothing rather than a guess. See CONTENT_PENDING.md §2, §4 and §7.
 *
 * The accessibility link is deliberately worded "Accessibility / ADA
 * Compliance" and the note beside it states the standard the site is built
 * toward. It must never claim certification or full compliance — see
 * PROJECT_CONTEXT.md §7.
 */
import { professionals, pending, site } from '@config/site';
import { footerNav, legalNav } from '@config/navigation';
import Container from '@components/ui/Container.astro';
import KeyesLogo from './KeyesLogo.astro';
import Wordmark from './Wordmark.astro';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();

const hasLegalCopy =
  Boolean(pending.legal.brokerageLegalName) ||
  Boolean(pending.legal.brokerageLicense) ||
  Boolean(pending.legal.footerDisclosure);
---

<footer class="bg-evergreen-800 text-white" data-surface="dark">
  {/* ══════════════════════════════════════════════════════════ masthead ══ */}
  <Container class="grid gap-14 border-b border-line-inverse py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:gap-20 lg:py-20">
    <div class="flex flex-col gap-8">
      <a href="/" class="w-fit rounded-xs" aria-label="Hoffman & Closius — home">
        <Wordmark tone="light" size="lg" />
      </a>

      <p class="max-w-sm text-sm leading-relaxed text-white/70">
        Representation for buyers, sellers and relocating families across {site.region}.
      </p>

      <KeyesLogo tone="dark" height={46} />

      {
        pending.officeAddress && (
          <address class="text-sm not-italic leading-relaxed text-white/70">
            {pending.officeAddress.street}
            <br />
            {pending.officeAddress.street2 && (
              <>
                {pending.officeAddress.street2}
                <br />
              </>
            )}
            {pending.officeAddress.city}, {pending.officeAddress.state}{' '}
            {pending.officeAddress.postalCode}
          </address>
        )
      }

      <SocialLinks tone="light" class="-ml-2" />
    </div>

    {/* Direct contacts */}
    <div class="grid gap-8 sm:grid-cols-2">
      {
        professionals.map((person) => (
          <div class="flex flex-col gap-2">
            <p class="font-serif text-2xl text-white">
              <a href={person.href} class="link-underline">
                {person.name}
              </a>
            </p>
            <p class="eyebrow text-gold-300">
              {person.specialty
                ? `${person.title} · ${person.specialty}`
                : person.title}
            </p>
            <dl class="mt-2 flex flex-col gap-1.5 text-sm text-white/75">
              <div>
                <dt class="sr-only">Phone</dt>
                <dd>
                  <a
                    href={person.phone.href}
                    class="link-underline transition-colors hover:text-white"
                  >
                    <span class="sr-only">Call {person.firstName} on </span>
                    {person.phone.value}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="sr-only">Email</dt>
                <dd class="break-all">
                  <a
                    href={person.email.href}
                    class="link-underline transition-colors hover:text-white"
                  >
                    <span class="sr-only">Email {person.firstName} at </span>
                    {person.email.value}
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        ))
      }
    </div>
  </Container>

  {/* ═══════════════════════════════════════════════════════ sitemap nav ══ */}
  <Container class="grid gap-10 border-b border-line-inverse py-14 sm:grid-cols-2 lg:grid-cols-4">
    {
      footerNav.map((group) => (
        <nav aria-label={group.label} class="flex flex-col gap-4">
          <h2 class="eyebrow font-sans text-white/70">{group.label}</h2>
          <ul class="flex flex-col gap-2.5 text-sm">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="link-underline text-white/75 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </Container>

  {/* ═══════════════════════════════════════════════ accessibility note ══ */}
  <Container class="border-b border-line-inverse py-8">
    <p class="max-w-3xl text-xs leading-relaxed text-white/65">
      We are working to meet{' '}
      <strong class="font-medium text-white/85">WCAG 2.2 Level AA</strong>{' '}
      across this website. If you encounter a barrier, or need information in
      another format, please tell us and we will put it right —{' '}
      <a href="/accessibility/" class="link-underline text-white hover:text-gold-300">
        Accessibility / ADA Compliance
      </a>.
    </p>
  </Container>

  {/* ════════════════════════════════════════════════════════════ legal ══ */}
  <Container class="flex flex-col gap-6 py-10">
    {
      hasLegalCopy && (
        <div class="flex flex-col gap-2 text-xs leading-relaxed text-white/60">
          {pending.legal.brokerageLegalName && <p>{pending.legal.brokerageLegalName}</p>}
          {pending.legal.brokerageLicense && <p>{pending.legal.brokerageLicense}</p>}
          {pending.legal.footerDisclosure && <p>{pending.legal.footerDisclosure}</p>}
        </div>
      )
    }
    {/*
      Fair Housing / Equal Housing Opportunity and the brokerage's required
      disclosure wording are NOT yet confirmed (CONTENT_PENDING.md 4.1, 4.2,
      4.4). They render here the moment `pending.legal` is populated. Nothing
      is invented in the meantime.
    */}

    <div class="flex flex-col gap-4 text-xs text-white/60 md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>

      {/*
        Deliberately NOT a <nav> landmark. These three links repeat the "Legal"
        column above verbatim, and wrapping them in a second landmark produced
        two navigation regions both named "Legal" — indistinguishable to anyone
        navigating by landmark, and no help to anyone else. A short small-print
        list does not need a landmark of its own.
      */}
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          legalNav.map((link) => (
            <li>
              <a href={link.href} class="link-underline transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
