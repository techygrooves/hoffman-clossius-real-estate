---
/**
 * KeyesWordmark — a typographic rendering of the Keyes name.
 *
 * ── Why this exists ───────────────────────────────────────────────────────
 * The official Keyes artwork has not been supplied (CONTENT_PENDING.md 1.1).
 * The client asked for the name to be set as type in the meantime, matching
 * their existing site, rather than leaving a dashed placeholder box.
 *
 * ── What it deliberately is NOT ───────────────────────────────────────────
 * It does not trace, imitate or approximate the Keyes brush-script mark. A bad
 * reproduction of somebody's trademark is worse than clean type: it is wrong
 * in a way that looks deliberate, and it is the version that ends up
 * screenshotted. This is the name set honestly in the site's own serif.
 *
 * ── It is a fallback, and stays one ───────────────────────────────────────
 * `KeyesLogo` prefers the real asset whenever one exists in /public/brand/ and
 * only falls back to this. Dropping `keyes-logo.svg` in replaces it everywhere
 * with no code change — which remains the right end state.
 */
import { brokerageBrand } from '@config/site';
import { cn } from '@lib/cn';

interface Props {
  tone?: 'light' | 'dark';
  /** Rendered height of the lockup in px, to match the asset slot it fills. */
  height?: number;
  /** True when an adjacent element already names the brokerage. */
  decorative?: boolean;
  class?: string;
}

const { tone = 'light', height = 40, decorative = false, class: className } =
  Astro.props;

const isDark = tone === 'dark';

/*
 * The wordmark is sized from the slot height so it sits on the same optical
 * line as the real asset would. 0.62 keeps the cap height comfortably inside
 * the box once the serif's ascenders and descenders are accounted for.
 */
const fontSize = Math.round(height * 0.62);

/*
 * The registered mark sits ON THE BASELINE, to the lower right of the "s" —
 * not raised as a superscript. Corrected 2026-09-27 after the client compared
 * this against the real mark on keyes.com: there the ® is a small circled R
 * tucked under the tail of the "s", and a raised one reads as a footnote.
 *
 * 7px is the floor because below that the circle and the R inside it stop
 * resolving into distinct shapes and the glyph turns into a smudge.
 */
const markSize = Math.max(7, Math.round(fontSize * 0.24));
---

<span
  data-keyes-wordmark
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : brokerageBrand.alt}
  aria-hidden={decorative ? 'true' : undefined}
  style={`height:${height}px`}
  class={cn('inline-flex shrink-0 select-none items-center self-start', className)}
>
  {/*
    `items-baseline` is what puts the ® on the same baseline as the name, so
    it sits beside the foot of the "s" rather than floating above the cap
    line. The wrapper exists purely so that baseline alignment happens between
    these two, while the outer box still centres the pair in its slot.
  */}
  <span class="inline-flex items-baseline">
    <span
      aria-hidden="true"
      style={`font-size:${fontSize}px`}
      class={cn(
        'font-serif italic leading-none tracking-[0.005em]',
        isDark ? 'text-white' : 'text-evergreen-800',
      )}
    >
      Keyes
    </span>
    {/*
      The registered-trademark mark is part of how the name is presented on
      the client's own site, so it is carried here too.
    */}
    <span
      aria-hidden="true"
      style={`font-size:${markSize}px`}
      class={cn(
        'ml-0.5 leading-none',
        isDark ? 'text-white/70' : 'text-evergreen-800/70',
      )}
    >
      ®
    </span>
  </span>
</span>
