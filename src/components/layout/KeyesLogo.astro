---
/**
 * KeyesLogo — renders the official Keyes brand asset.
 *
 * RULES (PROJECT_CONTEXT.md §4):
 *  - The asset is displayed UNMODIFIED. Never recolour, redraw, stretch, crop,
 *    rotate, add filters/effects, or place it inside a decorative frame.
 *    Only the rendered height changes; aspect ratio is always preserved.
 *  - Never write relationship wording ("affiliated with", "backed by", ...)
 *    next to it. The logo stands on its own.
 *  - While the asset is missing this component falls back to `KeyesWordmark`,
 *    which sets the NAME as type in the site's own serif. That was the
 *    client's instruction (they asked for the name rather than a dashed box,
 *    matching their existing site). It still does not trace, imitate or
 *    approximate the Keyes brush-script mark — a bad reproduction of a
 *    trademark is worse than clean type.
 *  - The real asset always wins. Drop it in and the fallback disappears
 *    everywhere with no code change; that remains the right end state.
 *
 * ── THE IMAGE SLOT ────────────────────────────────────────────────────────
 * Drop the official files here and this component switches to them at build
 * time with no code change:
 *
 *    public/brand/keyes-logo.svg        light backgrounds (header, drawer)
 *    public/brand/keyes-logo-white.svg  reversed, for evergreen backgrounds
 *
 * .png and .webp are accepted fallbacks; resolution order is .svg → .png →
 * .webp. Afterwards set `brokerageBrand.width` / `.height` in
 * src/config/site.ts to the asset's true intrinsic dimensions.
 * Full notes: docs/keyes-logo.md · tracked in CONTENT_PENDING.md 1.1–1.3.
 * ──────────────────────────────────────────────────────────────────────────
 */
import fs from 'node:fs';
import path from 'node:path';
import { brokerageBrand } from '@config/site';
import KeyesWordmark from './KeyesWordmark.astro';
import { cn } from '@lib/cn';

interface Props {
  /** 'light' = asset for light backgrounds. 'dark' = reversed/white asset. */
  tone?: 'light' | 'dark';
  /** Rendered height in px. Width follows the asset's own aspect ratio. */
  height?: number;
  class?: string;
  /**
   * True when an adjacent element already names the brokerage, so the logo
   * can be exposed as decorative to assistive technology.
   */
  decorative?: boolean;
}

const {
  tone = 'light',
  height = 40,
  class: className,
  decorative = false,
} = Astro.props;

const BRAND_DIR = path.join(process.cwd(), 'public', 'brand');
const EXTENSIONS = ['.svg', '.png', '.webp'] as const;

/** Returns the first existing /brand asset for a base filename, else null. */
function resolveAsset(base: string): string | null {
  for (const ext of EXTENSIONS) {
    if (fs.existsSync(path.join(BRAND_DIR, `${base}${ext}`))) {
      return `/brand/${base}${ext}`;
    }
  }
  return null;
}

const preferred = tone === 'dark' ? 'keyes-logo-white' : 'keyes-logo';
const src = resolveAsset(preferred) ?? resolveAsset('keyes-logo');

const ratio = brokerageBrand.width / brokerageBrand.height;
const width = Math.round(height * ratio);
---

{
  src ? (
    <img
      src={src}
      alt={decorative ? '' : brokerageBrand.alt}
      aria-hidden={decorative ? 'true' : undefined}
      width={width}
      height={height}
      loading="eager"
      decoding="async"
      style={`height:${height}px;width:auto`}
      class={cn('block w-auto self-start object-contain', className)}
    />
  ) : (
    /*
     * No asset supplied yet, so the name is set as type. See KeyesWordmark for
     * why this is lettering rather than an attempt at the mark itself.
     */
    <KeyesWordmark
      tone={tone}
      height={height}
      decorative={decorative}
      class={className}
    />
  )
}
