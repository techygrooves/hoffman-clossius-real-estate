---
/**
 * Wordmark — the name lockup used in the header and footer.
 *
 * Typographic rather than an image file, so it stays crisp at every size and
 * costs nothing to load.
 *
 * ── What it says, and why ─────────────────────────────────────────────────
 * It used to read "Hoffman & Closius" over "South Florida Real Estate", which
 * presents a firm. There isn't one. Corrected 2026-10-23 at the client's
 * instruction: it is the two people by name, over the brokerage they work at.
 *
 * The brokerage line names Keyes and stops there. It is a title line, the way
 * every agent's card in the industry carries one — not a sentence explaining
 * the relationship, which PROJECT_CONTEXT.md §4 still forbids.
 */
import { site } from '@config/site';
import { cn } from '@lib/cn';

interface Props {
  tone?: 'dark' | 'light';
  /** Shows the small brokerage line under the names. */
  showTagline?: boolean;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  tone = 'dark',
  showTagline = true,
  size = 'md',
  class: className,
} = Astro.props;

const isLight = tone === 'light';

/*
 * Two names rather than two surnames is roughly twice the characters, so each
 * step is smaller than the single-line lockup it replaces and the names are
 * allowed to wrap. `text-balance` keeps a wrap near the middle instead of
 * leaving "Closius" stranded on its own line.
 */
const nameSize = {
  sm: 'text-sm sm:text-base',
  md: 'text-base sm:text-lg lg:text-xl',
  lg: 'text-lg sm:text-2xl lg:text-[1.75rem]',
}[size];
---

{/*
  data-wordmark marks this as the site's logotype. WCAG 1.4.3 exempts text that
  is part of a logo or brand name from the contrast minimum, which is what lets
  the gold ampersand stay gold; the automated contrast sweep skips this subtree
  for that reason and no other.
*/}
<span
  data-wordmark
  class={cn('flex min-w-0 flex-col justify-center leading-none', className)}
>
  <span
    class={cn(
      'font-serif leading-tight tracking-[0.01em] text-balance',
      nameSize,
      isLight ? 'text-white' : 'text-evergreen-800',
    )}
  >
    Martin Hoffman{' '}
    <span class={isLight ? 'text-gold-400' : 'text-gold-500'}>&amp;</span>{' '}
    MaryEllen Closius
  </span>
  {
    showTagline && (
      <span
        class={cn(
          'mt-1.5 whitespace-nowrap font-sans text-[0.5625rem] uppercase tracking-eyebrow sm:text-[0.625rem]',
          isLight ? 'text-white/60' : 'text-ink-subtle',
        )}
      >
        {site.brokerage}
      </span>
    )
  }
</span>
