---
/**
 * Martin Hoffman P.A. — profile.
 *
 * Confirmed facts, and only confirmed facts: name, title, phone, email
 * (PROJECT_CONTEXT.md §1). No years in the business, no transaction count, no
 * sales volume, no award, no ranking, no designation, no association
 * membership, no licence number — none of it has been supplied, and on a page
 * whose whole job is to establish whether someone is trustworthy, an invented
 * credential is the worst possible thing to put.
 *
 * The one piece of interpretation on the page is what a Broker-Associate
 * licence is, which is a matter of Florida licensing rather than a claim about
 * Martin. Everything else waits for him.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { personSchema } from '@lib/seo/schema';
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import PersonHero from '@components/people/PersonHero.astro';
import PersonBio from '@components/people/PersonBio.astro';
import PersonSpecialties from '@components/people/PersonSpecialties.astro';
import PersonContactCard from '@components/people/PersonContactCard.astro';
import PersonListings from '@components/people/PersonListings.astro';
import ConsultationCta from '@components/people/ConsultationCta.astro';
import { getProfessional } from '@config/site';

const person = getProfessional('martin-hoffman');
if (!person) throw new Error('Martin Hoffman is missing from src/config/site.ts');

/**
 * What the licence itself means. This is Florida licensing law, not a
 * statement about Martin's record — it says what he is permitted to do, and
 * nothing about how often or how well he has done it.
 */
const LICENCE_NOTES = [
  {
    title: 'A broker-level licence, working within a brokerage',
    body: 'A Broker-Associate has qualified for a broker licence — a higher level than a sales associate — and practises under a brokerage rather than running one. It is a licensing distinction, and it is why the title reads the way it does.',
  },
  {
    title: 'Represents both sides of a transaction',
    body: 'Martin works with buyers and with sellers. Which side of a deal you are on changes the advice, not the standard of it.',
  },
  {
    title: 'Across three counties',
    body: 'Broward, Palm Beach and Miami-Dade. South Florida is not one market, and what is true of Aventura is not true of Pembroke Pines.',
  },
];

const WORKING_WITH = [
  {
    eyebrow: 'Buying',
    title: 'Looking for a home',
    body: 'From working out what you are actually looking for through to closing — including the parts that are negotiable and the parts that are not.',
    href: '/buy/',
    cta: 'How buying works',
  },
  {
    eyebrow: 'Selling',
    title: 'Putting a property on the market',
    body: 'Preparation, pricing, marketing and negotiation. Starting with an opinion of value prepared by a person, not by this website.',
    href: '/sell/',
    cta: 'How selling works',
  },
];
---

<BaseLayout
  title="Martin Hoffman P.A."
  description="Martin Hoffman P.A., Broker-Associate with Hoffman & Closius, representing buyers and sellers across Broward, Palm Beach and Miami-Dade. Direct line 954-605-4823."
  schema={[person ? personSchema(person) : null]}
>
  <PersonHero
    person={person}
    lead="Broker-Associate with Hoffman & Closius, representing buyers and sellers across South Florida."
    breadcrumbs={[{ label: 'About', href: '/about/' }, { label: 'Martin Hoffman P.A.' }]}
    seed={1}
  />

  {/* Biography + contact card */}
  <Section tone="white" labelledby="martin-bio-heading">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7 xl:col-span-8">
        <SectionHeader
          id="martin-bio-heading"
          eyebrow="About Martin"
          title="Who you would be working with"
        />
        <PersonBio person={person} class="mt-8" />

        <div class="mt-12 grid gap-px overflow-hidden rounded-xs border border-line bg-line sm:grid-cols-1">
          {
            LICENCE_NOTES.map((note) => (
              <div class="bg-white p-7" data-reveal>
                <h3 class="font-serif text-xl text-evergreen-800">{note.title}</h3>
                <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink-muted">
                  {note.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <aside class="lg:col-span-5 xl:col-span-4">
        <div class="lg:sticky lg:top-32 flex flex-col gap-8">
          <PersonContactCard person={person} heading="Reach Martin directly" />

          <div class="rounded-xs border border-line p-6 sm:p-8">
            <h2 class="font-serif text-xl text-evergreen-800">Working as a pair</h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              Martin works alongside MaryEllen Closius P.A., a Realtor Associate
              and Relocation Specialist. Between them you get two people on a
              transaction rather than one, and the one better placed to help
              takes the lead.
            </p>
            <a
              href="/about/maryellen-closius/"
              class="link-underline mt-4 inline-block text-sm text-evergreen-800"
            >
              Meet MaryEllen
            </a>
          </div>
        </div>
      </aside>
    </div>
  </Section>

  {/* Specialities — renders nothing at all until the client confirms them. */}
  <PersonSpecialties person={person} id="martin-specialties-heading" />

  {/* Listings */}
  <PersonListings person={person} id="martin-listings-heading" tone="warm" />

  {/* What working with him covers */}
  <Section tone="white" labelledby="martin-services-heading">
    <SectionHeader
      id="martin-services-heading"
      eyebrow="Where to start"
      title="Buying or selling"
    />

    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        WORKING_WITH.map((item, index) => (
          <li>
            <a
              href={item.href}
              class="group flex h-full flex-col rounded-xs border border-line p-7 transition-shadow duration-500 hover:shadow-card"
              data-reveal
              style={`--reveal-delay:${index * 60}ms`}
            >
              <p class="eyebrow text-evergreen-600">
                <span class="rule-gold" aria-hidden="true" />
                {item.eyebrow}
              </p>
              <h3 class="mt-4 font-serif text-2xl text-evergreen-800">{item.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{item.body}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-eyebrow text-evergreen-700">
                {item.cta}
                <svg
                  class="h-3 w-3 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                  aria-hidden="true"
                >
                  <path d="M1 8h13M9 3l5 5-5 5" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
      <Button href="/properties/search/" variant="secondary" withArrow>
        Search properties
      </Button>
      <Button href="/sell/home-evaluation/" variant="ghost">
        Request a home evaluation
      </Button>
    </div>
  </Section>

  <ConsultationCta person={person} id="martin-consultation-heading" />
</BaseLayout>
