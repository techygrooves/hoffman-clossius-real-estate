---
/**
 * About Hoffman & Closius.
 *
 * The page a visitor reaches when they are deciding whether to trust two
 * people with the largest transaction of their life — which makes it the page
 * where an invented credential does the most damage.
 *
 * So: no years in business, no transaction count, no sales volume, no award,
 * no ranking, no designation, no association membership, no licence number,
 * no team story. None of it has been supplied (CONTENT_PENDING.md 8.1–8.6),
 * and none of it may be inferred from the two confirmed titles.
 *
 * What the page does instead is say what is genuinely true and genuinely
 * useful: there are two of them, here is what each is licensed as, here is the
 * area they cover, and here is how to reach them without going through anyone.
 * That is a real proposition, and it is one they can stand behind.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';
import TestimonialCard from '@components/testimonials/TestimonialCard.astro';
import TestimonialEmptyState from '@components/testimonials/TestimonialEmptyState.astro';
import { getProfessional, professionals, serviceArea } from '@config/site';
import { communities } from '@data/communities';
import { verifiedTestimonials } from '@data/testimonials';

const martin = getProfessional('martin-hoffman');
const maryellen = getProfessional('maryellen-closius');

/** Only client-verified quotes ever render. Two is enough for a preview. */
const testimonials = verifiedTestimonials().slice(0, 2);

const counties = serviceArea.counties;

const APPROACH = [
  {
    eyebrow: 'For buyers',
    title: 'Fewer viewings, better ones',
    body: 'The work happens before the touring does: separating what you need from what you would like, so weekends are not spent on homes that were never right. Then the parts that decide a purchase — what comparable homes actually sold for, what an inspection turns up, what is genuinely negotiable.',
    href: '/buy/',
    cta: 'How buying works',
  },
  {
    eyebrow: 'For sellers',
    title: 'The first week is the one that counts',
    body: 'A property gets one launch, and most of the attention it will ever receive arrives in it. Preparation, an asking price built from what sold rather than what is asking, and presentation that earns the viewings — before it goes live, not after a reduction.',
    href: '/sell/',
    cta: 'How selling works',
  },
  {
    eyebrow: 'For people relocating',
    title: 'Choosing an area you have not lived in',
    body: 'Buying somewhere you do not yet know is a different exercise from buying down the road. Most people get one or two trips to decide, which changes how a search has to be run.',
    href: '/relocation/',
    cta: 'Relocation guide',
  },
];

const HOW_WE_WORK = [
  {
    title: 'You get one of us, not a queue',
    body: 'Both numbers on this site are direct lines. Martin and MaryEllen answer their own phones — there is no call centre and no assistant in between.',
  },
  {
    title: 'Two people on a transaction',
    body: 'Whichever of them you start with, the other is there. The one better placed to help on a given question takes it.',
  },
  {
    title: 'A straight answer, including when it is no',
    body: 'If the right advice is to wait, to spend less, or that a property is not worth what it is asking, that is what you will be told. Talking someone into the wrong house is how you get one commission instead of a client.',
  },
];

const LINKS = [
  {
    eyebrow: 'Search',
    title: 'Search properties',
    body: 'Filter by location, price, size and features. Every search is shareable.',
    href: '/properties/search/',
    cta: 'Start searching',
  },
  {
    eyebrow: 'Sell',
    title: 'Home evaluation',
    body: 'An opinion of value prepared by Martin or MaryEllen. No cost, no obligation.',
    href: '/sell/home-evaluation/',
    cta: 'Request an evaluation',
  },
  {
    eyebrow: 'Buy',
    title: 'Dream Home Finder',
    body: 'Tell us what you are looking for and hear about it as it comes to market.',
    href: '/buy/dream-home-finder/',
    cta: 'Tell us what you want',
  },
  {
    eyebrow: 'Communities',
    title: 'Explore neighbourhoods',
    body: 'Where you buy shapes daily life more than the house does.',
    href: '/communities/',
    cta: 'Explore communities',
  },
];
---

<BaseLayout
  title="About Us"
  description="Meet Martin Hoffman P.A., Broker-Associate, and MaryEllen Closius P.A., Realtor Associate and Relocation Specialist — Hoffman & Closius, working across Broward, Palm Beach and Miami-Dade."
>
  {/* Hero — joint photograph slot */}
  <section class="relative isolate overflow-hidden bg-cream-100 text-ink">
    <Container>
      <div class="section-space">
        <Breadcrumbs items={[{ label: 'About' }]} class="mb-10" />

        <div class="grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-16">
          <div class="lg:col-span-6" data-reveal>
            <p class="eyebrow text-evergreen-600">
              <span class="rule-gold" aria-hidden="true"></span>
              Our team
            </p>
            <h1 class="mt-5 text-display text-evergreen-800">
              Two people, three counties
            </h1>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-muted">
              Hoffman &amp; Closius is Martin Hoffman P.A. and MaryEllen Closius
              P.A. That is the whole team, and it is the point — you deal with
              the person doing the work, on their own number, from the first
              call to the closing table.
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
              <Button href="/contact/" size="lg" withArrow>Get in touch</Button>
              <Button href="/properties/search/" size="lg" variant="secondary">
                Search properties
              </Button>
            </div>
          </div>

          <div class="lg:col-span-6" data-reveal style="--reveal-delay:100ms">
            {/*
              Joint photograph of the two of them. Until it is supplied this is
              the neutral abstract placeholder — never a stock photograph of
              two people who are not Martin and MaryEllen
              (CONTENT_PENDING.md 8.3).
            */}
            <MediaSlot
              src={null}
              alt=""
              width={1200}
              height={900}
              ratio="4/3"
              seed={3}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="max-h-[28rem] rounded-xs"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  {/* Introduction */}
  <Section tone="white" labelledby="about-intro-heading">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <SectionHeader
          id="about-intro-heading"
          eyebrow="Introduction"
          title="A small team, on purpose"
        />
        <div class="mt-8 flex max-w-prose flex-col gap-5 leading-relaxed text-ink-muted">
          <p>
            Most real estate websites open with a number: homes sold, years in
            the business, volume closed. You have no way to check any of it, and
            a figure chosen to sound reassuring tells you nothing about how
            someone will handle your sale. So this page starts somewhere else.
          </p>
          <p>
            What can be said plainly is the shape of the thing. Martin Hoffman
            P.A. holds a Broker-Associate licence. MaryEllen Closius P.A. is a
            Realtor Associate and Relocation Specialist. They work together
            across {counties[0]}, {counties[1]} and {counties[2]}, with buyers,
            with sellers, and with people moving to South Florida from
            somewhere else.
          </p>
          <p>
            Being two people rather than twenty is the trade they have made.
            You will not get a team of assistants, and you will not need to
            explain your situation twice.
          </p>
        </div>
      </div>

      <div class="lg:col-span-5">
        <ul class="flex flex-col gap-4 lg:mt-4">
          {
            HOW_WE_WORK.map((item, index) => (
              <li
                class="rounded-xs border border-line bg-cream-50 p-6"
                data-reveal
                style={`--reveal-delay:${index * 60}ms`}
              >
                <h3 class="font-serif text-xl text-evergreen-800">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  {/* Individual profile previews */}
  <Section tone="warm" labelledby="about-people-heading">
    <SectionHeader
      id="about-people-heading"
      eyebrow="The team"
      title="Martin and MaryEllen"
      lead="Two licences, two direct lines. Their full profiles carry everything they have confirmed about themselves — and nothing they have not."
    />

    <div class="mt-14 grid gap-10 md:grid-cols-2 lg:gap-14">
      {
        [martin, maryellen].map(
          (person, index) =>
            person && (
              <article
                class="group flex flex-col rounded-xs border border-line bg-white p-7 sm:p-9"
                data-reveal
                style={`--reveal-delay:${index * 80}ms`}
              >
                {/*
                  Capped height keeps two portraits side by side from dominating
                  the page; `mx-auto` centres the slot in the card once the cap
                  makes it narrower than the column, rather than leaving it
                  pinned left with a gap beside it.
                */}
                <a href={person.href} class="block overflow-hidden rounded-xs">
                  <MediaSlot
                    src={person.portrait}
                    alt={person.portrait ? `${person.name}, ${person.title}` : ''}
                    width={720}
                    height={900}
                    ratio="4/5"
                    seed={index + 1}
                    sizes="(min-width: 768px) 45vw, 100vw"
                    class="mx-auto max-h-[26rem] rounded-xs"
                    imgClass="transition-transform duration-700 ease-[var(--ease-editorial)] motion-safe:group-hover:scale-[1.03]"
                  />
                </a>

                <h3 class="mt-7 text-display-sm text-evergreen-800">
                  <a href={person.href} class="link-underline">
                    {person.name}
                  </a>
                </h3>

                <p class="eyebrow mt-3 text-evergreen-600">
                  <span class="rule-gold" aria-hidden="true" />
                  {person.specialty
                    ? `${person.title} · ${person.specialty}`
                    : person.title}
                </p>

                <p class="mt-5 flex-1 leading-relaxed text-ink-muted">
                  {person.slug === 'martin-hoffman'
                    ? 'A Broker-Associate licence is the broker-level qualification, held while practising under a brokerage. Martin represents buyers and sellers across all three counties.'
                    : 'Realtor Associate and Relocation Specialist. MaryEllen works with buyers and sellers, and with families arriving in South Florida from out of state.'}
                </p>

                <dl class="mt-6 flex flex-col gap-1.5 border-t border-line pt-5 text-sm">
                  <div>
                    <dt class="sr-only">Phone</dt>
                    <dd>
                      <a href={person.phone.href} class="link-underline text-evergreen-800">
                        <span class="sr-only">Call {person.firstName} on </span>
                        {person.phone.value}
                      </a>
                    </dd>
                  </div>
                  <div>
                    <dt class="sr-only">Email</dt>
                    <dd class="break-all">
                      <a href={person.email.href} class="link-underline text-ink-muted">
                        <span class="sr-only">Email {person.firstName} at </span>
                        {person.email.value}
                      </a>
                    </dd>
                  </div>
                </dl>

                <div class="mt-7">
                  <Button href={person.href} variant="secondary" withArrow>
                    Meet {person.firstName}
                  </Button>
                </div>
              </article>
            ),
        )
      }
    </div>
  </Section>

  {/* Approach */}
  <Section tone="white" labelledby="about-approach-heading">
    <SectionHeader
      id="about-approach-heading"
      eyebrow="How they work"
      title="What the job actually is"
      lead="Three situations, and what changes between them."
    />

    <ul class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        APPROACH.map((item, index) => (
          <li>
            <a
              href={item.href}
              class="group flex h-full flex-col rounded-xs border border-line p-7 transition-shadow duration-500 hover:shadow-card"
              data-reveal
              style={`--reveal-delay:${index * 60}ms`}
            >
              <p class="eyebrow text-evergreen-600">
                <span class="rule-gold" aria-hidden="true" />
                {item.eyebrow}
              </p>
              <h3 class="mt-4 font-serif text-2xl text-evergreen-800">{item.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{item.body}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-eyebrow text-evergreen-700">
                {item.cta}
                <svg
                  class="h-3 w-3 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                  aria-hidden="true"
                >
                  <path d="M1 8h13M9 3l5 5-5 5" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* South Florida focus */}
  <Section tone="deep" labelledby="about-area-heading">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <p class="eyebrow text-gold-300">
          <span class="rule-gold" aria-hidden="true"></span>
          Where they work
        </p>
        <h2 id="about-area-heading" class="mt-5 text-display-sm text-white">
          South Florida is not one market
        </h2>
        <div class="mt-6 flex max-w-lg flex-col gap-5 leading-relaxed text-white/75">
          <p>
            {counties[0]}, {counties[1]} and {counties[2]} — three counties that
            behave differently and, within them, neighbourhoods that behave
            differently again. What is true of a waterfront condominium in
            Aventura is not true of a single-family house in Pembroke Pines: not
            the buyers, not the timelines, not the insurance, not what a
            renovation returns.
          </p>
          <p>
            Working a defined area rather than the whole state is what makes it
            possible to know that. It is also the reason we will tell you when
            something falls outside it.
          </p>
        </div>

        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/communities/" variant="gold" withArrow>
            Explore communities
          </Button>
          <Button href="/properties/search/" variant="inverse">
            Search properties
          </Button>
        </div>
      </div>

      <div data-reveal style="--reveal-delay:100ms">
        <p class="text-xs uppercase tracking-eyebrow text-white/70">
          Neighbourhood guides
        </p>
        <ul class="mt-5 grid gap-px overflow-hidden rounded-xs border border-white/15 bg-white/15 sm:grid-cols-2">
          {
            communities.map((community) => (
              <li>
                <a
                  href={`/communities/${community.slug}/`}
                  class="flex h-full flex-col bg-evergreen-800 p-5 transition-colors hover:bg-evergreen-900"
                >
                  <span class="font-serif text-xl text-white">{community.name}</span>
                  <span class="mt-1 text-xs uppercase tracking-wide-sm text-white/70">
                    {community.county}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  {/* Property and service links */}
  <Section tone="white" labelledby="about-links-heading">
    <SectionHeader
      id="about-links-heading"
      eyebrow="Where to start"
      title="Four ways in"
    />

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        LINKS.map((item, index) => (
          <li>
            <a
              href={item.href}
              class="group flex h-full flex-col rounded-xs border border-line bg-cream-50 p-7 transition-shadow duration-500 hover:shadow-card"
              data-reveal
              style={`--reveal-delay:${index * 60}ms`}
            >
              <p class="eyebrow text-evergreen-600">
                <span class="rule-gold" aria-hidden="true" />
                {item.eyebrow}
              </p>
              <h3 class="mt-4 font-serif text-xl text-evergreen-800">{item.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{item.body}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-eyebrow text-evergreen-700">
                {item.cta}
                <svg
                  class="h-3 w-3 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                  aria-hidden="true"
                >
                  <path d="M1 8h13M9 3l5 5-5 5" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* Testimonial preview */}
  <Section tone="warm" labelledby="about-testimonials-heading">
    <SectionHeader
      id="about-testimonials-heading"
      eyebrow="Client experience"
      title="In their own words"
      align="center"
    />

    {
      testimonials.length > 0 ? (
        <ul class="mt-14 grid gap-6 md:grid-cols-2">
          {testimonials.map((testimonial, index) => (
            <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
              <TestimonialCard testimonial={testimonial} />
            </li>
          ))}
        </ul>
      ) : (
        <TestimonialEmptyState class="mt-14" />
      )
    }

    <div class="mt-12 flex justify-center" data-reveal>
      <Button href="/testimonials/" variant="secondary" withArrow>
        Read client testimonials
      </Button>
    </div>
  </Section>

  {/* Final contact CTA */}
  <Section tone="white" labelledby="about-contact-heading">
    <div class="rounded-xs border border-line bg-cream-50 p-8 sm:p-14" data-reveal>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-16">
        <div>
          <p class="eyebrow text-evergreen-600">
            <span class="rule-gold" aria-hidden="true"></span>
            No obligation
          </p>
          <h2 id="about-contact-heading" class="mt-4 text-display-sm text-evergreen-800">
            Start with a conversation
          </h2>
          <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">
            Tell either of them where you are — thinking about it, actively
            looking, or already under contract somewhere else — and you will get
            a straight answer about what to do next. Nothing to sign, and no
            follow-up campaign afterwards.
          </p>
        </div>

        <div class="flex flex-col gap-3 lg:shrink-0">
          <Button href="/contact/" withArrow>Contact us</Button>
          {
            professionals.map((person) => (
              <Button href={person.phone.href} variant="secondary">
                Call {person.firstName} — {person.phone.value}
              </Button>
            ))
          }
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
