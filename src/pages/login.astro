---
/**
 * Sign in.
 *
 * ── Why there is no password field on this page ───────────────────────────
 * This site is statically generated and has no backend of its own. There is
 * nothing here that could verify a password, so anything resembling a sign-in
 * form would be either decorative or homemade authentication — and a
 * decorative password field is not harmless: browsers offer to save what is
 * typed into it, password managers fill it, and people reuse credentials.
 *
 * So the credential step belongs to the account provider, on the provider's
 * own origin, and this page renders no `input[type=password]` in any build
 * mode. When a provider is configured (`src/lib/auth/`), this page hands off
 * to it. Until then it says plainly that accounts are not available yet and
 * points at what does work today.
 *
 * See AUTH_INTEGRATION.md and CONTENT_PENDING.md 5.10.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import Section from '@components/ui/Section.astro';
import Button from '@components/ui/Button.astro';
import AccountHandoff from '@components/auth/AccountHandoff.astro';
import AccountBenefits from '@components/auth/AccountBenefits.astro';
import { hasAccounts } from '@lib/auth/provider';
import { professionals } from '@config/site';
---

<BaseLayout
  title="Sign In"
  description="Sign in to your Hoffman & Closius saved searches and saved properties."
  noindex
>
  <PageHero
    eyebrow="Account"
    title="Sign in"
    lead="Saved searches and property alerts belong to the property search platform, which is not connected yet."
    breadcrumbs={[{ label: 'Sign In' }]}
  />

  <Section tone="white" labelledby="signin-heading">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 id="signin-heading" class="sr-only">Sign in</h2>

        {
          hasAccounts ? (
            <AccountHandoff intent="sign-in" />
          ) : (
            /*
              The honest state, and the one that ships today. It is a
              statement, not a form: there is no account to sign in to, so
              there is nothing to type.
            */
            <div
              class="rounded-xs border border-evergreen-800/25 bg-cream-50 p-7 sm:p-9"
              data-reveal
            >
              <span class="rule-gold" aria-hidden="true" />
              <h3 class="mt-5 font-serif text-2xl text-evergreen-800">
                Accounts are not available yet
              </h3>
              <p class="mt-4 max-w-prose text-sm leading-relaxed text-ink-muted">
                Saved searches and property alerts arrive with the property
                search system, and that is still being set up. Rather than show
                you a sign-in form with nothing behind it, this page will start
                working the day accounts do.
              </p>
              <p class="mt-4 max-w-prose text-sm leading-relaxed text-ink-muted">
                In the meantime, Martin and MaryEllen will set alerts up for you
                by hand — which is not a worse service, just a less automated
                one.
              </p>

              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <Button href="/register/" withArrow>Ask for property alerts</Button>
                <Button href="/properties/search/" variant="secondary">
                  Browse properties
                </Button>
              </div>
            </div>
          )
        }

        {/*
          A visitor who has saved properties on this device deserves to know
          where they actually live — and that clearing site data ends them.
        */}
        <div class="mt-10 rounded-xs border border-line p-6 sm:p-8" data-reveal>
          <h3 class="font-serif text-xl text-evergreen-800">
            About the properties you have saved
          </h3>
          <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-muted">
            Saving a property on this site keeps it in this browser, on this
            device only. It is not an account: it does not sync anywhere, it is
            not sent to us, and clearing your browsing data clears it. Once
            accounts are connected, a saved list will follow you between
            devices instead.
          </p>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="flex flex-col gap-8 lg:sticky lg:top-32">
          <AccountBenefits class="rounded-xs border border-line bg-cream-50 p-6 sm:p-8" />

          <div class="rounded-xs border border-line p-6 sm:p-8" data-reveal>
            <h2 class="font-serif text-xl text-evergreen-800">
              Want alerts before then?
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              Tell either of us what you are looking for and where, and you will
              hear from a person when something fits.
            </p>
            <ul class="mt-6 flex flex-col gap-5 border-t border-line pt-5">
              {
                professionals.map((person) => (
                  <li>
                    <p class="text-sm font-medium text-evergreen-800">
                      {person.name}
                    </p>
                    <div class="mt-2 flex flex-col gap-1 text-sm">
                      <a
                        href={person.phone.href}
                        class="link-underline w-fit text-evergreen-800"
                      >
                        {person.phone.value}
                      </a>
                      <a
                        href={person.email.href}
                        class="link-underline w-fit break-all text-evergreen-800"
                      >
                        {person.email.value}
                      </a>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
