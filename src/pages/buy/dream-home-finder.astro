---
/**
 * Dream Home Finder — the buyer preference form.
 *
 * Fourteen questions is a lot to ask, so the form is broken into four named
 * steps and only three answers are actually required: a name, an email and
 * how you would like to be contacted. Everything else says "(optional)".
 *
 * Nothing here promises a result. It does not claim a private database, an
 * off-market list or a match count — none of those exist. It says what will
 * happen: Martin or MaryEllen read it and reply.
 *
 * Arriving from a saved property search? The price, type and bedroom answers
 * are prefilled from the same query parameters the search page uses, in the
 * browser, because a static page cannot read them at build time.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import Section from '@components/ui/Section.astro';
import LeadForm from '@components/forms/LeadForm.astro';
import FormSection from '@components/forms/FormSection.astro';
import FormField from '@components/forms/FormField.astro';
import FormChoiceGroup from '@components/forms/FormChoiceGroup.astro';
import { professionals } from '@config/site';
import { communities } from '@data/communities';
import { PARAM, PROPERTY_TYPE_LABELS, SELECTABLE_PROPERTY_TYPES } from '@lib/listings/query';

const PRICES = [
  100000, 200000, 300000, 400000, 500000, 750000, 1000000, 1500000, 2000000,
  3000000, 5000000, 10000000,
];

const usd = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0,
});

const priceOptions = (prompt: string) => [
  { value: '', label: prompt },
  ...PRICES.map((price) => ({ value: String(price), label: usd.format(price) })),
];

const areaOptions = [
  ...communities.map((community) => ({
    value: community.name,
    label: community.name,
  })),
  { value: 'Elsewhere in Broward County', label: 'Elsewhere in Broward' },
  { value: 'Elsewhere in Miami-Dade County', label: 'Elsewhere in Miami-Dade' },
  { value: 'Palm Beach County', label: 'Palm Beach County' },
  { value: 'Not sure yet', label: 'Not sure yet' },
];

const propertyTypeOptions = SELECTABLE_PROPERTY_TYPES.filter(
  (type) => type !== 'commercial' && type !== 'other',
).map((type) => ({ value: type, label: PROPERTY_TYPE_LABELS[type] }));

const countOptions = (prompt: string, unit: string) => [
  { value: '', label: prompt },
  ...['1', '2', '3', '4', '5'].map((n) => ({
    value: n,
    label: `${n}+ ${unit}`,
  })),
];

const featureOptions = [
  'Waterfront',
  'Private pool',
  'Ocean or water view',
  'Garage',
  'Ground floor / no stairs',
  'Gated community',
  'Home office',
  'Guest suite',
  'Large yard',
  'Move-in ready',
  'Pet friendly',
  'Doorman or concierge',
].map((label) => ({ value: label, label }));

const timeframeOptions = [
  'Within 3 months',
  '3 to 6 months',
  '6 to 12 months',
  'More than a year',
  'Still deciding',
].map((label) => ({ value: label, label }));

const financingOptions = [
  'Cash purchase',
  'Pre-approved',
  'Speaking to a lender',
  'Not started yet',
  'Would like a lender introduction',
].map((label) => ({ value: label, label }));

const contactOptions = ['Email', 'Phone call', 'Text message'].map((label) => ({
  value: label,
  label,
}));
---

<BaseLayout
  title="Dream Home Finder"
  description="Tell Hoffman & Closius what you are looking for in a South Florida home — areas, budget, size and must-haves — and Martin or MaryEllen will come back to you."
>
  <PageHero
    eyebrow="Buy"
    title="Dream Home Finder"
    lead="Tell us what you are actually looking for. The more specific you are, the less of your time gets spent on homes that were never right. Only three answers are required — skip anything you have not decided yet."
    breadcrumbs={[{ label: 'Buy', href: '/buy/' }, { label: 'Dream Home Finder' }]}
  />

  <Section tone="white" labelledby="finder-heading">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7 xl:col-span-8">
        <h2 id="finder-heading" class="sr-only">Your home search preferences</h2>

        <LeadForm
          kind="dream-home-finder"
          submitLabel="Send My Preferences"
          emailSubject="Dream Home Finder — buyer preferences"
        >
          <FormSection
            step={1}
            title="How to reach you"
            description="So we can reply, and in the way you prefer."
          >
            <FormField
              name="name"
              label="Full name"
              required
              autocomplete="name"
              span={6}
            />
            <FormField
              name="email"
              label="Email"
              type="email"
              required
              autocomplete="email"
              inputmode="email"
              span={6}
            />
            <FormField
              name="phone"
              label="Phone"
              type="tel"
              autocomplete="tel"
              inputmode="tel"
              hint="Only needed if you would rather we called or texted."
              span={6}
            />
            <FormChoiceGroup
              name="contactMethod"
              legend="Preferred contact method"
              options={contactOptions}
              required
              span={12}
            />
          </FormSection>

          <FormSection
            step={2}
            title="Where you want to be"
            description="Choose as many as you like. If you are open, say so — it is a useful answer."
          >
            <FormChoiceGroup
              name="areas"
              legend="Desired areas"
              type="checkbox"
              options={areaOptions}
              hint="Pick any that apply."
              prefillParam={PARAM.location}
              span={12}
            />
            <FormField
              name="areaNotes"
              label="Anything more specific"
              placeholder="A street, a building, a school zone, a commute"
              span={12}
            />
          </FormSection>

          <FormSection
            step={3}
            title="The home itself"
            description="A range is fine. Nothing here is treated as a commitment."
          >
            <FormField
              name="minPrice"
              label="Minimum price"
              type="select"
              options={priceOptions('No minimum')}
              prefillParam={PARAM.minPrice}
              span={6}
            />
            <FormField
              name="maxPrice"
              label="Maximum price"
              type="select"
              options={priceOptions('No maximum')}
              prefillParam={PARAM.maxPrice}
              span={6}
            />
            <FormField
              name="beds"
              label="Bedrooms"
              type="select"
              options={countOptions('Any', 'bedrooms')}
              prefillParam={PARAM.beds}
              span={6}
            />
            <FormField
              name="baths"
              label="Bathrooms"
              type="select"
              options={countOptions('Any', 'bathrooms')}
              prefillParam={PARAM.baths}
              span={6}
            />
            <FormChoiceGroup
              name="propertyType"
              legend="Property type"
              type="checkbox"
              options={propertyTypeOptions}
              prefillParam={PARAM.propertyType}
              span={12}
            />
            <FormChoiceGroup
              name="features"
              legend="Must-have features"
              type="checkbox"
              options={featureOptions}
              hint="Only the things you would not compromise on."
              span={12}
            />
          </FormSection>

          <FormSection
            step={4}
            title="Timing and financing"
            description="This tells us how to pace things. There is no wrong answer, and no pressure attached to any of them."
          >
            <FormChoiceGroup
              name="timeframe"
              legend="Desired move timeframe"
              options={timeframeOptions}
              span={12}
            />
            <FormChoiceGroup
              name="financing"
              legend="Financing status"
              options={financingOptions}
              span={12}
            />
            <FormField
              name="notes"
              label="Additional requirements"
              type="textarea"
              rows={5}
              placeholder="Anything else that matters — accessibility needs, pets, a lease ending, a property you have already seen."
              span={12}
            />
          </FormSection>
        </LeadForm>
      </div>

      <aside class="lg:col-span-5 xl:col-span-4">
        <div class="lg:sticky lg:top-32 flex flex-col gap-8">
          <div class="rounded-xs border border-line bg-cream-50 p-6 sm:p-8">
            <span class="rule-gold" aria-hidden="true"></span>
            <h2 class="mt-4 font-serif text-2xl text-evergreen-800">
              What happens next
            </h2>
            <ol class="mt-5 flex flex-col gap-4 text-sm leading-relaxed text-ink-muted">
              <li class="flex gap-3">
                <span class="font-serif text-gold-700" aria-hidden="true">01</span>
                <span>Martin or MaryEllen reads what you sent — a person, not a queue.</span>
              </li>
              <li class="flex gap-3">
                <span class="font-serif text-gold-700" aria-hidden="true">02</span>
                <span>
                  They come back to you the way you asked, with questions if
                  anything needs pinning down.
                </span>
              </li>
              <li class="flex gap-3">
                <span class="font-serif text-gold-700" aria-hidden="true">03</span>
                <span>
                  From there you get properties that fit the brief, and a note
                  when something changes.
                </span>
              </li>
            </ol>
            <p class="mt-6 border-t border-line pt-5 text-xs leading-relaxed text-ink-subtle">
              Sending this does not commit you to anything, and there is no
              agreement to sign to start looking.
            </p>
          </div>

          <div class="rounded-xs border border-line p-6 sm:p-8">
            <h2 class="font-serif text-xl text-evergreen-800">
              Would rather just talk?
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              Call either of us. A five-minute conversation often covers more
              than a form.
            </p>
            <ul class="mt-5 flex flex-col gap-4">
              {
                professionals.map((person) => (
                  <li>
                    <p class="text-sm font-medium text-evergreen-800">
                      {person.name}
                    </p>
                    <p class="text-xs text-ink-subtle">{person.title}</p>
                    <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                      <a href={person.phone.href} class="link-underline text-evergreen-800">
                        {person.phone.value}
                      </a>
                      <a href={person.email.href} class="link-underline text-evergreen-800">
                        {person.email.value}
                      </a>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-xs border border-line p-6 sm:p-8">
            <h2 class="font-serif text-xl text-evergreen-800">
              Prefer to browse first?
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              Search what is available and come back when you have a clearer
              picture. Your filters carry over into this form.
            </p>
            <a
              href="/properties/search/"
              class="link-underline mt-4 inline-block text-sm text-evergreen-800"
            >
              Search properties
            </a>
          </div>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
