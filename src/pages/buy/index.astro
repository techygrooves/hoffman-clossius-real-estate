---
/**
 * Buyer services.
 *
 * Describes how the process works and what the two of them do. It makes no
 * guarantee about outcomes, timelines, savings or access, and cites no
 * statistic — none has been supplied, and a buyer's decision is not a place
 * for invented numbers.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import Section from '@components/ui/Section.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';
import AgentCard from '@components/ui/AgentCard.astro';
import { getProfessional, professionals } from '@config/site';

const martin = getProfessional('martin-hoffman');
const maryellen = getProfessional('maryellen-closius');

const JOURNEY = [
  {
    title: 'Work out what you are actually looking for',
    body: 'Before searching, it helps to separate what you need from what you would like. Budget, area, commute, schools, whether you want a project — most searches narrow quickly once those are settled.',
  },
  {
    title: 'Talk to a lender',
    body: 'A lender tells you what you can borrow and what it costs monthly. Sellers in South Florida generally expect a pre-approval alongside an offer, so this comes before serious viewing, not after.',
  },
  {
    title: 'Search, and keep searching',
    body: 'You watch the portals; we watch the market — including what is coming and what has quietly changed price. Between us, less gets missed.',
  },
  {
    title: 'View properly',
    body: 'A viewing is for the things photographs do not show: noise, light at the wrong time of day, what the neighbours are like, how the building is run.',
  },
  {
    title: 'Offer',
    body: 'What to offer depends on what comparable homes actually sold for, how long this one has been available and how motivated the seller is. We put that together with you before you commit to a number.',
  },
  {
    title: 'Inspection, appraisal and contingencies',
    body: 'Florida contracts give you defined windows to inspect and to secure financing. What turns up in an inspection is often negotiable — this is where a lot of value is won or lost.',
  },
  {
    title: 'Closing',
    body: 'Title work, insurance, the final walkthrough and the closing itself. We stay on it so the dates hold.',
  },
];

const ROUTES = [
  {
    eyebrow: 'Search',
    title: 'Search homes',
    body: 'Filter by location, price, size and features. Every search is shareable — the URL carries your filters.',
    href: '/properties/search/',
    cta: 'Start searching',
  },
  {
    eyebrow: 'Communities',
    title: 'Explore neighbourhoods',
    body: 'From the Intracoastal to the western suburbs. Where you buy shapes daily life more than the house does.',
    href: '/communities/',
    cta: 'Explore communities',
  },
  {
    eyebrow: 'New construction',
    title: 'New developments',
    body: 'Pre-construction rarely reaches the open market the way resale does. Allocations move through relationships.',
    href: '/developments/new/',
    cta: 'View developments',
  },
  {
    eyebrow: 'Financing',
    title: 'Estimate a payment',
    body: 'Work out what a purchase looks like monthly before you tour. Estimates only — your lender gives you the real figures.',
    href: '/mortgage-calculator/',
    cta: 'Open the calculator',
  },
];
---

<BaseLayout
  title="Buying a Home"
  description="How representation works when you buy in South Florida — from the first search through to closing, with Martin Hoffman P.A. and MaryEllen Closius P.A."
>
  <PageHero
    eyebrow="Buy"
    title="Buying in South Florida"
    lead="You work directly with Martin and MaryEllen — from the first search through to the closing table."
    breadcrumbs={[{ label: 'Buy' }]}
  >
    <div class="mt-2 flex flex-wrap gap-3">
      <Button href="/properties/search/" size="lg" withArrow>Search Properties</Button>
      <Button href="/buy/dream-home-finder/" size="lg" variant="secondary">
        Dream Home Finder
      </Button>
    </div>
  </PageHero>

  {/* The journey */}
  <Section tone="white" labelledby="buyer-journey-heading">
    <SectionHeader
      id="buyer-journey-heading"
      eyebrow="How it works"
      title="What buying actually involves"
      lead="Seven stages, in the order they usually happen. Some overlap, and no two purchases run identically — but this is the shape of it."
    />

    <ol class="mt-14 grid gap-px overflow-hidden rounded-xs border border-line bg-line md:grid-cols-2">
      {
        JOURNEY.map((step, index) => (
          <li class="flex gap-5 bg-white p-7" data-reveal>
            <span
              class="shrink-0 font-serif text-2xl text-gold-600"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="font-serif text-xl text-evergreen-800">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* Where to go next */}
  <Section tone="warm" labelledby="buyer-routes-heading">
    <SectionHeader
      id="buyer-routes-heading"
      eyebrow="Start here"
      title="Four ways in"
    />

    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        ROUTES.map((route, index) => (
          <li>
            <a
              href={route.href}
              class="group flex h-full flex-col rounded-xs border border-line bg-white p-7 transition-shadow duration-500 hover:shadow-card"
              data-reveal
              style={`--reveal-delay:${index * 60}ms`}
            >
              <p class="eyebrow text-evergreen-600">
                <span class="rule-gold" aria-hidden="true" />
                {route.eyebrow}
              </p>
              <h3 class="mt-4 font-serif text-2xl text-evergreen-800">{route.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{route.body}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-xs uppercase tracking-eyebrow text-evergreen-700">
                {route.cta}
                <svg
                  class="h-3 w-3 transition-transform duration-300 ease-[var(--ease-editorial)] motion-safe:group-hover:translate-x-1"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                  aria-hidden="true"
                >
                  <path d="M1 8h13M9 3l5 5-5 5" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* Dream Home Finder */}
  <Section tone="deep" labelledby="dream-home-heading">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-20">
      <div data-reveal>
        <p class="eyebrow text-gold-300">
          <span class="rule-gold" aria-hidden="true"></span>
          Dream Home Finder
        </p>
        <h2 id="dream-home-heading" class="mt-5 text-display-sm text-white">
          Tell us what you are looking for
        </h2>
        <p class="mt-5 max-w-lg leading-relaxed text-white/75">
          The portals show you what is listed today. Telling us what you want
          means we can watch for it — including properties that have not reached
          the open market, and ones whose circumstances have changed.
        </p>
        <div class="mt-9">
          <Button href="/buy/dream-home-finder/" variant="gold" withArrow>
            Start the Dream Home Finder
          </Button>
        </div>
      </div>

      <div data-reveal style="--reveal-delay:100ms">
        <MediaSlot
          src={null}
          width={1000}
          height={800}
          ratio="5/4"
          tone="deep"
          seed={1}
          sizes="(min-width: 1024px) 45vw, 100vw"
          class="max-h-[26rem] rounded-xs"
        />
      </div>
    </div>
  </Section>

  {/* Relocation */}
  <Section tone="white" labelledby="buyer-relocation-heading">
    <div class="rounded-xs border border-line bg-cream-50 p-8 sm:p-12" data-reveal>
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
        <div>
          <p class="eyebrow text-evergreen-600">
            <span class="rule-gold" aria-hidden="true"></span>
            Relocation
          </p>
          <h2 id="buyer-relocation-heading" class="mt-4 text-display-sm text-evergreen-800">
            Moving from out of state?
          </h2>
          {
            maryellen && (
              <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">
                {maryellen.name} is a {maryellen.specialty}. Buying somewhere you
                do not yet know is a different exercise from buying down the
                road — and it is the part she works on most.
              </p>
            )
          }
        </div>
        <div class="lg:shrink-0">
          <Button href="/relocation/" variant="secondary" withArrow>
            Relocation guide
          </Button>
        </div>
      </div>
    </div>
  </Section>

  {/* Contact */}
  <Section tone="warm" labelledby="buyer-contact-heading">
    <SectionHeader
      id="buyer-contact-heading"
      eyebrow="Talk to us"
      title="Start with a conversation"
      lead="No obligation, and no script. Tell us where you are in the process and we will tell you what we would do next."
    />

    <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-10 lg:gap-16">
      {
        [martin, maryellen].map(
          (person, index) =>
            person && (
              <AgentCard
                person={person}
                intro={
                  person.slug === 'martin-hoffman'
                    ? 'Martin holds a Broker-Associate licence and represents buyers and sellers across South Florida.'
                    : 'MaryEllen is a Realtor Associate and Relocation Specialist, working with buyers, sellers and families moving to South Florida.'
                }
                ctaLabel={`Meet ${person.firstName}`}
                seed={index + 1}
              />
            ),
        )
      }
    </div>

    <div class="mt-14 flex flex-wrap justify-center gap-3" data-reveal>
      <Button href="/contact/" withArrow>Contact us</Button>
      {
        professionals.map((person) => (
          <Button href={person.phone.href} variant="secondary">
            Call {person.firstName}
          </Button>
        ))
      }
    </div>
  </Section>
</BaseLayout>
