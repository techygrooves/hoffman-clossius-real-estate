---
/**
 * Create an account.
 *
 * ── What this page is, today ──────────────────────────────────────────────
 * There is no account system (`src/lib/auth/`), so this page does not create
 * one, and does not pretend to. What it does instead is genuinely useful and
 * genuinely honest: it collects the details a saved search needs — name,
 * email, phone, and where you are looking — and sends them to Martin and
 * MaryEllen as an ordinary enquiry, through the same lead service every other
 * form on the site uses. They set the alerts up by hand.
 *
 * **No password is asked for, and no `input[type=password]` is rendered in any
 * build mode.** A password with nothing to verify it is not a placeholder: it
 * is a credential collected by a page that cannot protect it. When a real
 * provider is connected, registration — and the password that comes with it —
 * happens on the provider's own origin, and this page hands off instead.
 *
 * See AUTH_INTEGRATION.md and CONTENT_PENDING.md 5.10.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/ui/PageHero.astro';
import Section from '@components/ui/Section.astro';
import LeadForm from '@components/forms/LeadForm.astro';
import FormSection from '@components/forms/FormSection.astro';
import FormField from '@components/forms/FormField.astro';
import AccountHandoff from '@components/auth/AccountHandoff.astro';
import AccountBenefits from '@components/auth/AccountBenefits.astro';
import { hasAccounts } from '@lib/auth/provider';
---

<BaseLayout
  title="Create Account"
  description="Ask Hoffman & Closius to set up property alerts for you — tell us what you are looking for and where, and you will hear from a person when something fits."
  noindex
>
  <PageHero
    eyebrow="Account"
    title={hasAccounts ? 'Create an account' : 'Set up property alerts'}
    lead={
      hasAccounts
        ? 'Save your searches and be told when a matching property comes to market.'
        : 'Accounts are not connected yet — so Martin and MaryEllen will set your alerts up by hand instead.'
    }
    breadcrumbs={[{ label: hasAccounts ? 'Create Account' : 'Property Alerts' }]}
  />

  <Section tone="white" labelledby="register-heading">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7 xl:col-span-8">
        {
          hasAccounts ? (
            <>
              <h2 id="register-heading" class="sr-only">
                Create an account
              </h2>
              <AccountHandoff intent="register" />
            </>
          ) : (
            <>
              <header class="flex flex-col gap-4" data-reveal>
                <p class="eyebrow text-evergreen-600">
                  <span class="rule-gold" aria-hidden="true" />
                  Property alerts
                </p>
                <h2
                  id="register-heading"
                  class="text-display-sm text-evergreen-800"
                >
                  Tell us where you are looking
                </h2>
                <p class="max-w-2xl text-lg leading-relaxed text-ink-muted">
                  Automatic alerts arrive with the property search system. Until
                  they do, send these four details and one of us will watch the
                  market for you and get in touch when something fits.
                </p>
              </header>

              {/*
                Said before the form rather than after it: someone filling in a
                page headed "create an account" should know within a sentence
                that they are not creating one.
              */}
              <p
                class="mt-8 rounded-xs border border-evergreen-800/25 bg-evergreen-100 px-5 py-4 text-sm leading-relaxed text-evergreen-900"
                data-reveal
              >
                This does not create an account and asks for no password. It
                sends your details to Martin and MaryEllen, who set the alerts
                up themselves.
              </p>

              <LeadForm
                kind="property-alerts"
                submitLabel="Request Property Alerts"
                emailSubject="Property alerts request"
                class="mt-12"
              >
                <FormSection
                  step={1}
                  title="Your details"
                  description="Four fields. No password, because there is no account to protect."
                >
                  <FormField
                    name="name"
                    label="Name"
                    required
                    autocomplete="name"
                    span={6}
                  />
                  <FormField
                    name="email"
                    label="Email"
                    type="email"
                    required
                    autocomplete="email"
                    inputmode="email"
                    hint="Where the alerts will be sent."
                    span={6}
                  />
                  <FormField
                    name="phone"
                    label="Phone"
                    type="tel"
                    autocomplete="tel"
                    inputmode="tel"
                    span={6}
                  />
                  <FormField
                    name="area"
                    label="ZIP code or area of interest"
                    required
                    placeholder="e.g. 33019, Hollywood, or Fort Lauderdale beaches"
                    hint="A ZIP code, a city or a neighbourhood — whichever describes where you are looking."
                    span={6}
                  />
                </FormSection>
              </LeadForm>
            </>
          )
        }
      </div>

      <aside class="lg:col-span-5 xl:col-span-4">
        <div class="flex flex-col gap-8 lg:sticky lg:top-32">
          <AccountBenefits
            heading="What alerts will do"
            class="rounded-xs border border-line bg-cream-50 p-6 sm:p-8"
          />

          <div class="rounded-xs border border-line p-6 sm:p-8" data-reveal>
            <h2 class="font-serif text-xl text-evergreen-800">
              Looking for something specific?
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              The Dream Home Finder asks the fuller set of questions — budget,
              size, areas and must-haves — which makes the alerts sharper than a
              ZIP code alone can.
            </p>
            <a
              href="/buy/dream-home-finder/"
              class="link-underline mt-4 inline-block py-1 text-sm text-evergreen-800"
            >
              Dream Home Finder
            </a>
          </div>

          <div class="rounded-xs border border-line p-6 sm:p-8" data-reveal>
            <h2 class="font-serif text-xl text-evergreen-800">
              Already asked us?
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">
              There is no account to sign in to yet. When accounts are
              connected, the sign-in page will start working.
            </p>
            <a
              href="/login/"
              class="link-underline mt-4 inline-block py-1 text-sm text-evergreen-800"
            >
              Sign in
            </a>
          </div>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
