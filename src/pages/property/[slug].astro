---
/**
 * Individual property detail page.
 *
 * Generated from `resolveRoutableListings()` — real listings when they exist,
 * the clearly-marked demo records when the demo flag is on, and nothing at all
 * in a production build with no MLS feed. It must use the same resolver the
 * listing cards use, or a demo build links to pages that were never built.
 */
import type { GetStaticPaths } from 'astro';
import StubPage from '@layouts/StubPage.astro';
import { resolveRoutableListings } from '@lib/content';

export const getStaticPaths = (() => {
  const { items, isDemo } = resolveRoutableListings();
  return items.map((listing) => ({
    params: { slug: listing.slug },
    props: { listing, isDemo },
  }));
}) satisfies GetStaticPaths;

const { listing, isDemo } = Astro.props;
---

<StubPage
  title={listing.headline}
  heading={listing.headline}
  eyebrow="Property"
  description={listing.description ?? `${listing.addressLine}, ${listing.city}, ${listing.state}`}
  breadcrumbs={[
    { label: 'Properties' },
    { label: 'For Sale', href: '/properties/for-sale/' },
    { label: listing.addressLine },
  ]}
  note={
    isDemo
      ? 'This is a sample record, not a real property — placeholder content used to review the design before the MLS feed is connected. The property detail template (gallery, specification, map and enquiry form) is built once the feed defines the real field set.'
      : 'The property detail template — gallery, specification, map and enquiry form — is built once the MLS feed defines the real field set.'
  }
  noindex={isDemo}
/>
