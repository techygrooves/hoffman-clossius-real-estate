{
  "name": "hoffman-closius-real-estate",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Hoffman & Closius \u2014 South Florida real estate website (Astro + Tailwind, static output).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && node --test tests/*.test.mjs && astro build && node scripts/verify-links.mjs",
    "build:fast": "astro build",
    "build:demo": "PUBLIC_DEMO_CONTENT=true astro build",
    "build:portable": "astro build && node scripts/make-portable.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "verify:links": "node scripts/verify-links.mjs",
    "astro": "astro",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "typescript": "^5.9.2"
  }
}
